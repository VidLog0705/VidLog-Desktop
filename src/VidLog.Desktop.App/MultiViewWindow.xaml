<Window x:Class="VidLog.Desktop.App.MultiViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时多画面" Width="1200" Height="820"
        MinWidth="720" MinHeight="520"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 工具条 ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                               Text="实时多画面"/>
                    <!-- ⚠️ 这句就是设计图上那句：双击进全屏、全屏内可旋转、Esc 返回。 -->
                    <TextBlock Style="{StaticResource Caption}" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640"
                               Text="双击某一格进入全屏（全屏里能换画质），按 Esc 返回；右键选择画面数；每格右上角那颗按钮转 90°。"/>
                </StackPanel>
                <Button Grid.Column="0" x:Name="CloseButton" Content="关闭"
                        Style="{StaticResource SecondaryButton}" MinWidth="88"
                        HorizontalAlignment="Right" Click="OnClose"/>
            </Grid>
        </Border>

        <!-- ══ 画面墙 ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 一台机位都没有时的一句话（设计图原话就是这个意思）。
                 ⚠️ **它有自己的那一行，不许盖在墙上**：先前它和墙同处一个格子、
                 居中 —— 正中那一格自己写着「无信号输入」，两句话叠在一起都看不清
                 （2026-10-02 实机报上来的）。收掉格子来避让也不行：那样整页只剩一
                 句话，用户会以为多画面坏了（需求方 2026-10-02：「改回原来我们自己的
                 渲染」）。所以是**把它挪开**，不是把格子收掉。 -->
            <TextBlock x:Name="EmptyNote" Grid.Row="0" Visibility="Collapsed"
                       HorizontalAlignment="Center" Margin="0,0,0,12"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                       Foreground="{StaticResource TextSecondary}"
                       Text="正在查找已开启实时共享的手机…&#x0a;（在手机上打开实时共享之后，这里会出现它的画面。）"/>

            <UniformGrid x:Name="Wall" Grid.Row="1" Rows="3" Columns="3"/>
        </Grid>

        <!-- ══ 全屏层 ══════════════════════════════════════════════ -->
        <!-- ⚠️ 盖住整个窗口（RowSpan=2）：全屏就是「只看这一格」，
             工具条与别的格子都不该还在。 -->
        <Grid x:Name="FullscreenLayer" Grid.RowSpan="2" Background="{StaticResource VideoBackground}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 画面本体由 code-behind 挂进来（同一张 Image 在两个容器间搬，见 .cs） -->
            <Grid x:Name="FullscreenHost" Grid.Row="0"/>

            <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="20,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FullscreenTitle" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" Text="全屏"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="按 Esc 退出全屏。"/>
                    </StackPanel>

                    <StackPanel x:Name="QualityRow" Orientation="Horizontal" Margin="0,10,0,0"/>

                    <!-- ⚠️ 「好处与坏处」必须写在界面上（需求原话：「但需要告知用户
                         选择三档时的好处及坏处」）—— 只摆三个没有说明的选项等于没告知。 -->
                    <TextBlock x:Name="QualityTradeoff" Style="{StaticResource Caption}"
                               Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="760"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
