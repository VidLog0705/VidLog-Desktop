<Window x:Class="VidLog.Desktop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VidLog.Desktop.App"
        mc:Ignorable="d"
        Title="设置" Height="700" Width="900" MinWidth="780" MinHeight="560"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing">
    <!--
        ════════════════════════════════════════════════════════════════
        设置窗口（2026-09-28 从 MainWindow 拆出来）

        ⚠️ 为什么拆：需求方的设计图里「设置」是一个**带标题栏的独立窗口**
        （左导航 7 节 + 底部确定/应用/取消），不是主窗口里的一页。
        裁决是「严格照图」，所以主窗那边不再有设置页。

        ⚠️ 导航**只列真做了的节**。设计图上还有「百度网盘上传」与
        「扩展与联动」两节 —— 它们分别要批次 5 与批次 8 才有内容，
        现在列出来就是**点进去什么都没有的空壳**（踩坑 #13：
        绝不渲染一个没有任何作用的开关）。做完一节加一节。

        ⚠️ 保存方式照图改成**显式保存**（确定 / 应用 / 取消）——
        此前是「改一个下拉就立刻存盘」。这是有意的行为变更。

        ⚠️ 守卫测试按文本盯着 `new EnrollWindow(`，它现在落在
        本文件的 code-behind 里（`DesktopServicesTests` 那一处断言原文未改）。
        ════════════════════════════════════════════════════════════════
    -->
    <Window.Resources>
        <!--
            表体。两张表（录像保存位置 / 录像备份位置）共用。
            ⚠️ 选中态是 `AccentWeak`（蓝底）、未选中是白 —— 都是量自设计图 `_43` 的
            （选中行 #DBEAFE / 普通行 #F8FAFC 表头 #F1F5F9）。
            ⚠️ 触发器**顺序有意义**：后写的赢，所以 `IsSelected` 必须排在
            `IsMouseOver` 后面，否则鼠标一划过去选中行就不蓝了。
        -->
        <Style x:Key="DiskTable" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MaxHeight" Value="170"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,7" SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{StaticResource SurfaceMuted}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{StaticResource AccentWeak}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            多磁盘那两张表里的一行（设计图 `_43`）。两张表**同一个模板**：
            列一样（存储路径 | 预留空间），只有「预留空间」那一格能不能改不同
            （备份位置那一列是死的，原因写在 `ReserveHint` 里）。
        -->
        <DataTemplate x:Key="DiskSlotTemplate">
            <Grid PreviewMouseLeftButtonDown="OnDiskRowMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Folder}"
                           VerticalAlignment="Center" FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimary}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBox Width="64" Padding="6,3" TextAlignment="Right"
                             Background="{StaticResource SurfaceMuted}"
                             BorderBrush="{StaticResource CardBorder}"
                             Text="{Binding ReservedGb, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding ReserveEditable}"
                             ToolTip="{Binding ReserveHint}"
                             ToolTipService.ShowOnDisabled="True"
                             TextChanged="OnDiskEdited"/>
                    <TextBlock Text="GB" Margin="8,0,0,0" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ 左导航 ══════════════════════════════════════════════════
             ⚠️ 底色是 slate-50（`SidebarBackground`），而**选中项是白的** ——
             这是从设计图里量出来的，不是「浅蓝底」。见 Theme.xaml 的说明。 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <!-- 左下角那颗（设计图 `_45` / `_46` 的位置）。 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="设置" Margin="20,22,20,18"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDevice" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Device" IsChecked="True"
                                 Content="设备与外观" Checked="OnSectionChanged"/>
                    <!-- ⚠️ 批次 G 新增的三节。次序**照前身产品的页签次序**：
                         设备与外观 / 扫码与识别 / 存储与备份 / 百度网盘上传 /
                         录像设置 / 声音与播报 / 局域网与网页 / 扩展与联动 / 高级设置 / 关于。
                         ⚠️ 前身那一排有 **11** 节，我们只列 **10**：少的那一节是
                         「面单放大」—— 它整页只有一个「面单智能特写」开关 + 一条
                         「最大放大倍数」滑杆，而**那个功能批次 D 已裁定判给手机端**
                         （2026-10-02 需求方拍板）⇒ 摆出来就是一个管不着任何东西的开关
                         （§63「绝不画假开关」）。前身那一页长什么样已拍下留档：
                         `H:\_installers\shots\x-tab-2.png` / `x-tab-2.txt`，
                         裁定过程见 `实现决策.md` §91.8。 -->
                    <RadioButton x:Name="NavScan" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Scan"
                                 Content="扫码与识别" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavStorage" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Storage"
                                 Content="存储与备份" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavCloud" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Cloud"
                                 Content="百度网盘上传" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavRecording" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Recording"
                                 Content="录像设置" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavAudio" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Audio"
                                 Content="声音与播报" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Network"
                                 Content="局域网与网页" Checked="OnSectionChanged"/>
                    <!-- ⚠️ 设计图的左导航有 **7** 节，这一节此前**根本没列出来**
                         （注释里写着「导航只列真做了的节」）。需求方 2026-10-01 改了口径：
                         **没做的功能也留入口，点开如实说「正在开发中」** —— 见本节内容。 -->
                    <RadioButton x:Name="NavExtensions" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Extensions"
                                 Content="扩展与联动" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="Advanced"
                                 Content="高级设置" Checked="OnSectionChanged"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                 GroupName="SettingsNav" Tag="About"
                                 Content="关于" Checked="OnSectionChanged"/>
                </StackPanel>

                <!-- ⚠️ 设计图左下角那颗。**可点**，点开说「正在开发中」——
                     需求方 2026-10-01 裁决。这**推翻了**先前那条「禁用 + 悬停写明原因」
                     （实时多画面 / 订单联动是用那一条办的）。 -->
                <Button Grid.Row="2" x:Name="ExtensionMarketButton" Content="扩展市场"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch" Margin="20,10,20,18"
                        Click="OnOpenExtensionMarket"/>
            </Grid>
        </Border>

        <!-- ══ 右侧：内容 + 底部按钮条 ═══════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          Padding="28,24,28,16">
                <Grid>

                    <!-- ────────────────────────────────────────────────
                         ① 设备与外观
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="DeviceSection">
                        <!-- ── 电脑用途（批次 4，照设计图 `_42`）─────────────
                             ⚠️ 图上这一节**只有三行**（电脑用途 / 界面语言 / 外观主题），
                             而 VidLog 的这一节底下还有摄像头、录制声音、工作模式、
                             录制规格、连接手机 —— 那几样是真能力（图上是把它们
                             挪进了配置向导），所以这里是**加在最上面**，
                             不是把底下那些删掉。
                             ⚠️ 图上那句副标题写的是「选择这台电脑在 PackingProof
                             中承担的职责」—— 那是另一个产品的名字，这里换成 VidLog。
                             这是**全窗口唯一一处刻意改字**，其余每一句都照抄。
                             ⚠️ 下拉里的四项由 code-behind 从
                             `StationRoles.Describe` 填 —— 名字只有 Core 那一处产出，
                             免得这里写一份、结果卡上又写另一份。 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="电脑用途"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="选择这台电脑在 VidLog 中承担的职责。这一项要重启软件才生效。"/>
                        <ComboBox x:Name="RoleCombo" Width="300"
                                  SelectionChanged="OnRoleChanged"/>

                        <!-- ── 界面语言 / 外观主题（批次 9，照设计图 `_42`）─────
                             ⚠️ 图上这两行是能点、能改、改完重启生效的真设置，
                             而 VidLog **两个都只有一档**（界面只有中文、主题只有浅色）。
                             按裁决「设计图上能点、VidLog 没这功能的按钮 →
                             **禁用 + 悬停写明原因**」（踩坑 #13）办：唯一可用那一档
                             正常显示并选中，其余各项**禁用 + 悬停说清为什么**。
                             ⚠️ 所以这两行**不落盘**：一个只有一种取值的设置是假开关。
                             选项与那句话都从 `AppPreferences` 取（Core 里，测得到），
                             这里不写第二份文案。 -->
                        <Separator Margin="0,18,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="界面语言"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="380"
                                           Text="默认跟随 Windows 显示语言，修改后重启生效。"/>
                            </StackPanel>
                            <!-- ⚠️ 没有 SelectionChanged：表里只有一档能选（就是已经选中的
                                 那一档），另两档禁用 —— 挂一个处理器上去是永远不会跑的代码。 -->
                            <ComboBox Grid.Column="1" x:Name="LanguageCombo" Width="220"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="外观主题"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="380"
                                           Text="可跟随系统，或固定为浅色 / 深色主题。"/>
                            </StackPanel>
                            <!-- 同上：主题也只做了浅色那一档。 -->
                            <ComboBox Grid.Column="1" x:Name="ThemeCombo" Width="220"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ⚠️ 上面两个下拉**点得动**（需求方 2026-10-01 裁决：
                             「只留窗口，用户如点开，显示正在开发中」）——
                             选中还没做的那一档时在这里说一句实话，然后**退回**。
                             ⚠️ 不弹模态框：这一页是静态的，一句话放在点击处最近的地方最好找。 -->
                        <TextBlock x:Name="PreferencesNote" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="{StaticResource Warning}" Visibility="Collapsed"/>

                        <Separator Margin="0,18,0,16"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="摄像头"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="录制用哪一路画面。换了要重启才生效。"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CameraCombo" Width="300" IsEnabled="False"/>
                            <!-- ⚠️ `TextWrapping` + `MaxWidth` 两个都要：这一句是个
                                 **横排** StackPanel 的第二项，不给宽度上限时它按一行排、
                                 超出的部分被窗口边缘直接剪掉 —— 2026-10-02 实测看到的是
                                 「当前用的是网络摄像头（…），在」后面没了。 -->
                            <TextBlock x:Name="CameraHint" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="360"
                                       Foreground="{StaticResource TextSecondary}" Text=""/>
                        </StackPanel>

                        <!-- ⚠️ 配置向导的入口**搬到「高级设置」**了（批次 G：照前身产品的分页 ——
                             它把「配置向导 / 重新运行」放在高级设置，不在设备页）。
                             ⚠️ 上面那句「在【配置向导 → 选择摄像头】里改」**指向的仍是同一个东西**，
                             只是现在要先去「高级设置」那一页 —— 所以这里必须留一句指路，
                             否则那句话又变成指着一个找不到的入口。 -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="配置向导在【高级设置】里 —— 摄像头、摄像头识别、方向、麦克风、扫码枪都在那儿重配。"/>

                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ② 扫码与识别（批次 G 新增，照前身产品的分页）

                         ⚠️ 这一页上的两样**都是搬过来的**，没有新造开关：
                         「工作模式」原来在设备与外观，「扫码预录缓冲」也是 ——
                         前身产品把「打包模式」和「扫码预录制」都放在它这一页，
                         这两样正是我们这边对应的东西（§63：不画假开关）。
                         ⚠️ 前身这一页还有「摄像头自动识别面单」「全局键盘监听」
                         「托盘期间扫码监听」「无回车窗口内识别」四行 ——
                         我们这四样**只在配置向导里配**，没有独立的落盘设置，
                         所以**这一页不列它们**，免得点开是四个没反应的开关。
                         ⚠️ XAML 里的次序与左导航的次序**无关**（哪一页可见由
                         `OnSectionChanged` 按 Tag 切）—— 这里按左导航的次序排，
                         只是为了下一个人读起来顺。
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="ScanSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="工作模式"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="连续扫：换件即换段。同码停：复扫同一张单号就停 —— 它不会因为扫到别的面单就自动换段，也不会一路录到把盘写满。"/>
                        <ComboBox x:Name="ModeCombo" Width="260" HorizontalAlignment="Left"
                                  SelectionChanged="OnModeChanged">
                            <ComboBoxItem Tag="Continuous">连续扫（换件即换段）</ComboBoxItem>
                            <ComboBoxItem Tag="StopOnSameWaybill">同码停（复扫同号停）</ComboBoxItem>
                        </ComboBox>

                        <Separator Margin="0,18,0,16"/>

                        <!-- 预录缓冲（规格 §3.1.3，批次 C）。
                             ⚠️ 前身产品也把「扫码预录制」放在这一页，位置一致。
                             ⚠️ 但**那句「与识码无关」必须留着**：这一页的页名叫「识别」，
                             最容易被人读成「识码关掉它也就关了」—— 需求方 2026-10-02
                             恰好裁定的是**识码关掉它照样生效**。这句话是那一页上最要紧的一句。 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="扫码预录缓冲"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="把包裹放上秤、面单刚朝镜头的那几秒也留住。开始工作的这段时间摄像头一直被占着（指示灯会常亮）。改了下次开始工作生效。"/>
                        <ComboBox x:Name="PrerecordCombo" Width="140" HorizontalAlignment="Left"
                                  SelectionChanged="OnPrerecordChanged">
                            <ComboBoxItem Tag="0">关闭</ComboBoxItem>
                            <ComboBoxItem Tag="3">3 秒</ComboBoxItem>
                            <ComboBoxItem Tag="5">5 秒</ComboBoxItem>
                            <ComboBoxItem Tag="10">10 秒</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="⚠️ 与「用摄像头取景识码」无关：识码关掉时它照样生效。缓冲那几秒计入已录时长。"/>

                        <Separator Margin="0,18,0,16"/>

                        <!-- ⚠️ 摄像头识别、扫码枪、画面方向这三样**不在这一页**：
                             它们只有配置向导一个入口（见「高级设置」）。这里不摆
                             一个点开没反应的开关充数，指一句路就够。 -->
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="620"
                                   Text="⚠️ 摄像头取景识码、扫码枪、画面方向不在这里配 —— 它们在【高级设置 → 配置向导】里。"/>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ⑤ 录像设置（批次 G 新增，照前身产品的分页）

                         ⚠️ 前身产品这一页放的是「录制声音 / 分辨率 / 画面没变化时自动结束 /
                         限制录像时长 / 长时间不用时关闭摄像头 / 启用录像水印」。
                         我们对应得上的搬过来了（闲置提醒、时长兜底、录制规格），
                         对不上的（自动结束、摄像头空闲、水印）**本仓没有对应的落盘设置**，
                         所以这一页不列 —— 同 §63。
                         ⚠️ 「录制声音」按前身是放这一页的，我们**挪到了「声音与播报」**：
                         我们那页没有订单播报（批次 E 已裁定不写），只剩麦克风一行，
                         把录制声音也留在这一页会让「声音与播报」变成一句说明的空壳。
                         两样都是音频，放一起才讲得通。这是**有意偏离**，记在 §92。
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="RecordingSection" Visibility="Collapsed">
                        <!-- ⚠️ 引导式录像（`IMPLEMENTATION.md` M8 一行名字，零规格）。
                             入口原来在设备与外观（**我挑的位置**），批次 G 挪到这里 ——
                             它管的是录制过程中的行为，与前身「录像设置」这一类同族。 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="引导式录像"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="380"
                                           Text="录的时候给软提示，录完再检测一遍 —— 只提醒，不打断录制。"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="GuidedRecordingButton" Content="打开"
                                    Style="{StaticResource SecondaryButton}" MinWidth="88"
                                    VerticalAlignment="Center" Click="OnOpenGuidedRecording"/>
                        </Grid>

                        <Separator Margin="0,4,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="闲置提醒"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="连续 N 分钟没有任何扫码或打点就出声提醒。"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="IdleCombo" Width="110"
                                              SelectionChanged="OnIdleReminderChanged">
                                        <ComboBoxItem Tag="Off">关闭</ComboBoxItem>
                                        <ComboBoxItem Tag="Two">2 分钟</ComboBoxItem>
                                        <ComboBoxItem Tag="Three">3 分钟</ComboBoxItem>
                                        <ComboBoxItem Tag="Four">4 分钟</ComboBoxItem>
                                        <ComboBoxItem Tag="Five">5 分钟</ComboBoxItem>
                                        <ComboBoxItem Tag="Custom">自定义</ComboBoxItem>
                                    </ComboBox>
                                    <TextBox x:Name="IdleMinutesBox" Width="46" Margin="6,0,0,0"
                                             VerticalContentAlignment="Center"
                                             LostFocus="OnIdleMinutesChanged"/>
                                    <TextBlock Text="分钟" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="32,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="时长兜底"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="到点弹一条询问，不替你停。"/>
                                <ComboBox x:Name="DurationCombo" Width="110"
                                          SelectionChanged="OnDurationChanged">
                                    <ComboBoxItem Tag="Off">关闭</ComboBoxItem>
                                    <ComboBoxItem Tag="Four">4 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="Five">5 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="Six">6 分钟</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="闲置提醒只看「有没有扫码或打点」，不看画面；到点只出声提醒，不会替你停录 —— 真正会停的是时长兜底。"/>

                        <Separator Margin="0,18,0,16"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="录制规格"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="帧率固定 30，不提供选择。改了下次开段生效。"/>

                        <!-- ⚠️ 编码与分辨率**必须横排单选，不许换成下拉** ——
                             规格 §3.1.7 点名「横排（**不用下拉**）」，两端都是。 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="编码" Style="{StaticResource FieldLabel}"/>
                            <RadioButton x:Name="CodecH264" GroupName="Codec" Tag="H264"
                                         Content="H.264（兼容优先）" VerticalAlignment="Center"
                                         Checked="OnRecordingSpecChanged"/>
                            <RadioButton x:Name="CodecH265" GroupName="Codec" Tag="H265"
                                         Content="H.265（更省空间）" VerticalAlignment="Center"
                                         Margin="14,0,0,0" Checked="OnRecordingSpecChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}"/>
                            <RadioButton x:Name="Res4K" GroupName="Resolution" Tag="Uhd4K"
                                         Content="4K" VerticalAlignment="Center"
                                         Checked="OnRecordingSpecChanged"/>
                            <RadioButton x:Name="Res1080" GroupName="Resolution" Tag="P1080"
                                         Content="1080P" VerticalAlignment="Center"
                                         Margin="14,0,0,0" Checked="OnRecordingSpecChanged"/>
                            <RadioButton x:Name="Res720" GroupName="Resolution" Tag="P720"
                                         Content="720P" VerticalAlignment="Center"
                                         Margin="14,0,0,0" Checked="OnRecordingSpecChanged"/>
                        </StackPanel>

                        <!-- ⚠️ 规格：「**回落必须可见**……不得静默回落」——
                             这一行就是那个落点，**不折进「?」里**。 -->
                        <TextBlock x:Name="EffectiveSpecText" Margin="76,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" Text=""/>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ⑥ 声音与播报（批次 G 新增，照前身产品的分页）

                         ⚠️ 前身这一页是「语音提醒 / 播报时调为最大音量 / 订单备注播报 /
                         打印后退款报警 / 播报买家留言 / 播报卖家备注 / 播报商品信息 /
                         播报商品件数」—— 后六行全是**订单联动**，而批次 E 已裁定
                         「现在不写，只预留」（2026-10-02）⇒ 这一页**一行都不能摆**。
                         ⚠️ 「语音提醒」也摆不了：本仓的语音播报是**无条件的**
                         （`Platform.Speech.Speak` 在 `App.OnNotice` 里直接调，
                         没有落盘的开关）—— 加一个开关就是新功能，不是搬家，
                         没在本次范围内（§63：不画假开关）。
                         ⇒ 这一页留下的就是**本仓真有的音频设置**：录制声音 + 麦克风。
                         ⚠️ 前身把麦克风放在「设备与外观」、录制声音放在「录像设置」，
                         我们**有意把这两样合到这一页**（理由见上面「录像设置」那段）。
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="AudioSection" Visibility="Collapsed">
                        <!-- 录制声音（规格 §3.1.8）。设置项名逐字照规格，**默认开**。 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="录制声音"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="音轨固定为 AAC、单声道、44.1 kHz、64 kbps，不提供选择。改了下次开始工作生效，录制中不可改。"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- ⚠️ 挂 Checked/Unchecked 而**不是 Click**：Click 只在用户点的时候响，
                                 而 IsChecked 还能被别的途径改（UIA 的 TogglePattern 就是直接赋值的，
                                 2026-09-29 截图脚本实测：那样拨出来的开关是关的、旁边的字还写着「开」）。
                                 挂这两个事件，界面状态就**不可能**与开关本身走岔。 -->
                            <ToggleButton x:Name="AudioToggle" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="OnAudioChanged" Unchecked="OnAudioChanged"/>
                            <TextBlock x:Name="AudioStateText" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}" Text=""/>
                            <ComboBox x:Name="MicrophoneCombo" Width="260" Margin="18,0,0,0"
                                      IsEnabled="False"/>
                            <TextBlock x:Name="MicrophoneHint" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" Text=""/>
                        </StackPanel>

                        <!-- ⚠️ 这一条**不折进「?」**：它说的是「麦克风出问题也不会毁掉录像」，
                             不写出来用户不敢开声音（而且它正是 I4 在界面上的落点）。 -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="⚠️ 麦克风被拒、被别的程序占用、或者中途被拔掉，录像照常进行 —— 只有那一段没有音轨，界面上会写明原因。声音绝不会让整段录像失败。"/>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ③ 存储与备份

                         ⚠️ 这一节整体照设计图 `_43` 重排（批次 4）：顶上一条容量条、
                         「录像清理」两个入口、两张磁盘表（录像保存位置 / 录像备份位置），
                         底下才是 VidLog 自己的「归档层」与四档保留期 —— 图上那两样
                         也在这一节里，只是截图上被折在更下面。

                         图上每一句说明文字**逐字照抄**（含那句
                         「系统盘默认至少预留 30GB 或 10% …… 以较大值为准」，
                         它与 `Core/Cleanup/ReservedSpace.cs` 里的常数是同一件事）。
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="StorageSection" Visibility="Collapsed">

                        <!-- ── ⓪ 容量条（图上最上面那条）──────────────────
                             ⚠️ 条子的**底色量到的是 #CBD5E1**（`BorderStrong`），
                             8px 高、圆角。图上写着 `0.0 / 504.4 GB` —— 也就是
                             **已用为 0**，所以那个颜色是轨道不是填充。
                             填充色图上没有证据（空的），取设置窗那套蓝 `AccentStrong`；
                             它是个标定旋钮，见 `docs/实现决策.md`。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CapacityTrack" Grid.Column="0" Height="8"
                                    CornerRadius="4" Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    SizeChanged="OnCapacityTrackSized"
                                    Background="{StaticResource BorderStrong}">
                                <Border x:Name="CapacityFill" Width="0" CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentStrong}"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="CapacityText"
                                       Style="{StaticResource Body}" Text="正在统计…"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="CapacityNote" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0"/>

                        <Separator Margin="0,18,0,16"/>

                        <!-- ── ① 录像清理 ────────────────────────────────
                             ⚠️ 归档层就是本机磁盘时**整块收掉**（规格 §3.5.1）：
                             那时盘上这份是唯一副本，摆一个点了就报错的按钮不如不摆。 -->
                        <Grid x:Name="CleanupRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="录像清理" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="清理只影响电脑本地录像，NAS 中已备份的文件不会受到影响"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="CleanupByTimeButton" Content="按时间清理…"
                                        Style="{StaticResource SecondaryButton}" Padding="14,7"
                                        Click="OnCleanupByTime"/>
                                <Button x:Name="CleanupBySpaceButton" Content="按空间释放…"
                                        Style="{StaticResource SecondaryButton}" Padding="14,7"
                                        Margin="8,0,0,0" Click="OnCleanupBySpace"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CleanupNote" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0"/>

                        <Separator Margin="0,18,0,16"/>

                        <!-- ── ② 录像保存位置（多磁盘，规格 §3.5 的容量侧）── -->
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="录像保存位置" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="本地磁盘直接保存录像，空间不足时按保护期自动循环清理"/>

                        <Border Background="{StaticResource SurfaceAlt}"
                                CornerRadius="4,4,0,0" Padding="12,7" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Caption}" Text="存储路径"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                           Text="预留空间" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="SaveDiskList" Style="{StaticResource DiskTable}"
                                 ItemTemplate="{StaticResource DiskSlotTemplate}"
                                 SelectionChanged="OnDiskSelectionChanged"/>
                        <TextBlock x:Name="SaveDiskEmptyNote" Style="{StaticResource Caption}"
                                   Margin="12,8,0,0" Visibility="Collapsed"
                                   Text="还没有配置 —— 录像写在默认目录（数据目录下的 archive）里。"/>

                        <!-- ⚠️ 这一句**逐字照抄**设计图。里面的 30GB/10% 与
                             20GB/5% 就是 `Core/Cleanup/ReservedSpace.cs` 里那几个常数，
                             改了一处就必须改另一处。 -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="录像会按列表顺序保存。每个磁盘只剩下预留空间时，会自动换到下一个磁盘；系统盘默认至少预留 30GB 或 10%，其他磁盘至少预留 20GB 或 5%，以较大值为准"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="添加磁盘" Tag="Save"
                                    Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    Click="OnAddDisk"/>
                            <Button x:Name="SaveRemoveButton" Content="移除选中" Tag="Save"
                                    Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    Margin="8,0,0,0" Click="OnRemoveDisk"/>
                            <Button x:Name="SaveUpButton" Content="上移" Tag="Save"
                                    Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    Margin="8,0,0,0" Click="OnMoveDiskUp"/>
                            <Button x:Name="SaveDownButton" Content="下移" Tag="Save"
                                    Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    Margin="8,0,0,0" Click="OnMoveDiskDown"/>
                        </StackPanel>

                        <Separator Margin="0,18,0,16"/>

                        <!-- ── ③ 录像备份位置（归档层那一份落在哪儿）────── -->
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="录像备份位置" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="录像会按列表顺序备份到当前可用的位置；NAS 满时自动切换到下一个，NAS 中已备份的文件不会被程序删除"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="归档层" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ArchiveCombo" Width="200"
                                      SelectionChanged="OnArchiveChanged">
                                <ComboBoxItem Tag="LocalDisk">本机磁盘</ComboBoxItem>
                                <ComboBoxItem Tag="Nas">NAS</ComboBoxItem>
                                <ComboBoxItem Tag="MountedDrive">挂载网络驱动器</ComboBoxItem>
                                <ComboBoxItem Tag="Cloud">百度网盘</ComboBoxItem>
                            </ComboBox>
                            <local:HelpTip Margin="8,0,0,0"
                                           Text="录像备份到哪儿去了。只有在别处还有一份时，清掉盘上这份才是安全的。"/>
                        </StackPanel>
                        <TextBlock x:Name="ArchiveReachNote" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0"/>

                        <!-- 目录型的路径（NAS / 挂载盘）。这两档**共用一份实现**（规格 §3.4.6），
                             所以界面上也是同一张表 —— 再拆一张只会让两条路慢慢走岔。
                             ⚠️ 表里的路径与原来那个单行输入框是同一份配置
                             （`ArchiveDirectory`），老配置读进来就是一行。 -->
                        <StackPanel x:Name="ArchivePathPanel" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <Border Background="{StaticResource SurfaceAlt}"
                                    CornerRadius="4,4,0,0" Padding="12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Caption}" Text="存储路径"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                               Text="预留空间" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ListBox x:Name="BackupDiskList" Style="{StaticResource DiskTable}"
                                     ItemTemplate="{StaticResource DiskSlotTemplate}"
                                     SelectionChanged="OnDiskSelectionChanged"/>
                            <TextBlock x:Name="BackupDiskEmptyNote"
                                       Style="{StaticResource Caption}" Margin="12,8,0,0"
                                       Text="还没有配置 —— 先在【添加磁盘】里选一个可读写的目录，例如 \\nas\vidlog 或 Z:\vidlog。"/>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       Text="网络那一层（登录、凭据）由你在系统里挂好，我们只当成一个目录用。"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <local:HelpTip
                                    Text="⚠️ 这个路径只是「去哪儿找归档层」，不进索引 —— 换台机器挂到别的盘符，录像照样查得到。"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0"
                                           Text="换台机器挂到别的盘符会怎样"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button Content="添加磁盘" Tag="Backup"
                                        Style="{StaticResource SecondaryButton}" Padding="14,6"
                                        Click="OnAddDisk"/>
                                <Button x:Name="BackupRemoveButton" Content="移除选中" Tag="Backup"
                                        Style="{StaticResource SecondaryButton}" Padding="14,6"
                                        Margin="8,0,0,0" Click="OnRemoveDisk"/>
                                <Button x:Name="BackupUpButton" Content="上移" Tag="Backup"
                                        Style="{StaticResource SecondaryButton}" Padding="14,6"
                                        Margin="8,0,0,0" Click="OnMoveDiskUp"/>
                                <Button x:Name="BackupDownButton" Content="下移" Tag="Backup"
                                        Style="{StaticResource SecondaryButton}" Padding="14,6"
                                        Margin="8,0,0,0" Click="OnMoveDiskDown"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 归档层 = 本机磁盘时这块**不出现**（规格 §3.5.1）——
                             那时盘上这份是唯一副本，给了开关也只能是「改了没反应」。 -->
                        <Border x:Name="RetentionPanel" Margin="0,20,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="本地保留期（发货 / 退货 × 已备份 / 未备份 = 四个数）"/>

                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="发货"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="退货"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="已备份"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBox x:Name="ArchivedOutboundCombo" Grid.Row="1" Grid.Column="1"
                                              IsEditable="True" Margin="0,2,8,2"
                                              SelectionChanged="OnRetentionChanged"/>
                                    <ComboBox x:Name="ArchivedReturnCombo" Grid.Row="1" Grid.Column="2"
                                              IsEditable="True" Margin="0,2,0,2"
                                              SelectionChanged="OnRetentionChanged"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="未备份"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <ComboBox x:Name="UnarchivedOutboundCombo" Grid.Row="2" Grid.Column="1"
                                              IsEditable="True" Margin="0,2,8,2"
                                              SelectionChanged="OnRetentionChanged"/>
                                    <ComboBox x:Name="UnarchivedReturnCombo" Grid.Row="2" Grid.Column="2"
                                              IsEditable="True" Margin="0,2,0,2"
                                              SelectionChanged="OnRetentionChanged"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <local:HelpTip
                                        Text="四个数互相独立，改一个不动另一个。以「已备份」为例：它从归档成功那一刻起算，不是从录完起算。档位可以手输天数（例如 45）。"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0"
                                               Text="四个数怎么互相影响、档位能不能手输"/>
                                </StackPanel>

                                <!-- ⚠️ 下面四条**不折进「?」** —— 规格 §3.5 明令
                                     「禁止静默清理」并把它当成红线，藏起来等于把红线藏起来。 -->
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="⚠️ 这会真的删：每次启动算一遍到期该清的，先弹窗告诉你多少条、多少容量，你点了同意才动手（禁止静默清理）。删的只是本机上这一份 —— 归档层上那份不动。"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="⚠️「不保留」不是立刻删：最近 24 小时内录的一律不动（硬性豁免，关不掉），所以它实际是「归档后最快 24 小时清理」。"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="⚠️「未备份」那一列永不自动删除 —— 那是唯一副本，删了就永久没了。它到期的动作只有提醒（列表标红 + 催上传），起算点是录完时刻。"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="⚠️「已备份 = 不保留」而归档层还没接上时，清理由 §3.5.4 的回查把关：查不到或查不了都不删。"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="RetentionAbsentNote" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0"/>

                        <!-- 归档层那一份没发上去（规格 §3.4.6）。**必须说出来**：
                             它意味着盘上这份只有一份，而用户可能以为自己已经双份了。 -->
                        <TextBlock x:Name="ArchiveRelayNote" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Warning}" Margin="0,10,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ③ 百度网盘上传（批次 5，照设计图 `_45` / `_46`）
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="CloudSection" Visibility="Collapsed">
                        <!-- ⚠️ 归档层不是「百度网盘」那一档时，这一整页**全禁用**
                             并写明原因（踩坑 #13：绝不渲染一个按下去没反应的开关）。
                             原因由 code-behind 填，因为它是**当下**算出来的：
                             「档位不对」与「档位对但没配凭据」是两句不同的话。 -->
                        <TextBlock x:Name="CloudDisabledNote" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                   MaxWidth="520" Margin="0,0,0,14"
                                   Visibility="Collapsed"/>

                        <!-- ── 卡 1：账号与上传状态 ────────────────────── -->
                        <Border x:Name="CloudAccountCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="账号与上传状态"/>
                                <TextBlock x:Name="CloudAccountNote" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" MaxWidth="520"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="CloudLoginButton"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="登录百度网盘" Click="OnCloudLogin"/>
                                    <Button Grid.Column="1" x:Name="CloudLogoutButton"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Margin="10,0,0,0"
                                            Content="退出登录" Click="OnCloudLogout"/>
                                    <Button Grid.Column="2" x:Name="CloudSyncButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="立即对比同步" Click="OnCloudSync"/>
                                    <Button Grid.Column="3" x:Name="CloudRetryButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Content="立即重试失败上传" Click="OnCloudRetry"/>
                                </Grid>

                                <!-- 扫码授权（设备码模式）：手机上扫这张码就直接打开百度授权页，
                                     不用把上面那串验证码手抄过去。点了【登录百度网盘】才会出现。 -->
                                <StackPanel x:Name="CloudQrPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               MaxWidth="520"
                                               Text="用手机扫下面这张码：手机上会直接打开百度授权页，验证码也已经填好，登录并同意就行 —— 不用手抄那串码。"/>
                                    <!-- ⚠️ 这个 Border 的 `Background="White"` 是硬写的、**跟着 Theme 走会出事**：
                                         二维码要求高对比（码是黑的、底得是白的），
                                         用 Surface 或 PageBackground 那种带灰的底色会降低对比度。理由同 EnrollWindow。 -->
                                    <Border Margin="0,8,0,0" Padding="10" Background="White"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            CornerRadius="6" HorizontalAlignment="Left">
                                        <!-- 一个模块一个像素，靠最近邻放大成方块。
                                             换成插值会把模块边缘糊成灰边 —— 糊掉的码在屏幕上看着正常、扫不出来。 -->
                                        <Image x:Name="CloudQrImage" Width="240" Height="240" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── 卡 2：上传与补传 ────────────────────────── -->
                        <Border x:Name="CloudUploadCard" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="上传与补传"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           MaxWidth="520"
                                           Text="录像上传到百度网盘「我的应用数据/[网盘目录应用名]/(日期)/发货或退货/单号_会话_序号.mp4」，按开录日期与发货退货分类。"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="启用自动上传"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="仅此开关开启后新开始录制的视频会上传。"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="CloudAutoUploadToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="OnCloudAutoUploadChanged"
                                                  Unchecked="OnCloudAutoUploadChanged"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="自动对比补传"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="定期与网盘实际内容对比：网盘已有的单号视频自动去重，只补传网盘上没有的；开启后约每分钟检查一次队列。"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="CloudCompareToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="OnCloudCompareChanged"
                                                  Unchecked="OnCloudCompareChanged"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="补传范围"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="全部=本机所有可上传录像；自定起始日=只补该日及之后开录的（以开录自然日为准）。"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="CloudScopeCombo" Width="220"
                                                  SelectionChanged="OnCloudScopeChanged"/>
                                        <DatePicker x:Name="CloudFromDatePicker" Width="220"
                                                    Margin="0,6,0,0"
                                                    SelectedDateChanged="OnCloudFromDateChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="同时上传数"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="同一时间并行上传的录像条数，过大可能触发网盘风控。"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="CloudParallelCombo" Width="220"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="网盘目录应用名"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="开放平台后台填写的「产品名称」，远端路径为 /apps/(该名称)/。"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="CloudAppNameBox" Width="220"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── 卡 3：上传队列 ──────────────────────────── -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                                               Text="上传队列"/>
                                    <!-- 图上右上角那句状态（「暂无录像」就在这儿）。 -->
                                    <TextBlock Grid.Column="1" x:Name="CloudQueueNote"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <ListBox x:Name="CloudQueueList" Margin="0,12,0,0" MaxHeight="280"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="筛选" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CloudQueueFilterCombo" Width="140"
                                              Margin="8,0,0,0"
                                              SelectionChanged="OnCloudQueueFilterChanged"/>
                                    <TextBlock Text="每页" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                                    <TextBox x:Name="CloudQueuePageSizeBox" Width="60"
                                             Margin="8,0,0,0" Text="10"/>
                                    <Button x:Name="CloudQueuePrevButton" Style="{StaticResource SecondaryButton}"
                                            Margin="16,0,0,0" Content="◀" Click="OnCloudQueuePrev"/>
                                    <TextBlock x:Name="CloudQueuePageText" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Button x:Name="CloudQueueNextButton" Style="{StaticResource SecondaryButton}"
                                            Margin="12,0,0,0" Content="▶" Click="OnCloudQueueNext"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ④ 局域网与网页
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="NetworkSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="回放服务端口"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="PortBox" Width="120"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="改了要重启才生效。"/>
                        </StackPanel>

                        <TextBlock x:Name="ServerUrlText" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" Text=""/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   Text="手机与别的电脑在同一个局域网里，用上面这个地址就能打开回放页检索、播放。⚠️ 找不到录像时它不会伪造一个空结果 —— 服务没起来时这一行会直说「未启动」。"/>

                        <Separator Margin="0,18,0,16"/>

                        <!-- ⚠️ 「连接电脑 / 手机」原来是**设备与外观**里的一行（批次 G 搬来）：
                             前身产品把它归在「局域网与网页」，它确实是局域网里的事 ——
                             绑手机、发凭据、之后手机才连得上这台机器的回放服务。
                             它与上面的端口是同一件事的两半（一个是被连的地址，一个是谁被允许连）。 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="连接电脑 / 手机"/>
                        <StackPanel Orientation="Horizontal">
                            <local:HelpTip VerticalAlignment="Center"
                                           Text="点开弹出一张二维码，手机端扫它来申请连接。申请到了由你决定同意还是拒绝 —— 没有这一步，手机换不到凭据，录像传不上来。"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="手机要接进来，得先在这里发一张二维码。"/>
                        </StackPanel>
                        <Button x:Name="EnrollButton" Content="连接电脑/手机"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0" HorizontalAlignment="Left"
                                Click="OnEnroll"/>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         扩展与联动（设计图 `_48`）—— 需求方 2026-10-01：**只留入口**

                         ⚠️ 这一块三个仓里**只有里程碑表一行名字**
                         （`IMPLEMENTATION.md` M8：「扩展 API（**不自建扩展市场**）」），
                         没有任何行为规格。所以这里**什么都不实现**。
                         ⚠️ 这不违反踩坑 #13：那个开关按下去**有明确反馈**（一句实话），
                         而不是「按了没反应，用户以为是自己网络的问题」。
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="ExtensionsSection" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="扩展与联动"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="520"
                                           Text="这一节还在开发中。下面这两项将来会装在这里，现在点开只会看到一句实话。"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="扩展 API"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="让第三方脚本通过接口读取录像与单号。"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ExtensionApiButton" Content="打开"
                                            Style="{StaticResource SecondaryButton}" MinWidth="88"
                                            VerticalAlignment="Center" Click="OnOpenExtensionApi"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                                   Text="扩展市场"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" MaxWidth="420"
                                                   Text="浏览、安装别人写好的扩展。"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ExtensionMarketRowButton" Content="打开"
                                            Style="{StaticResource SecondaryButton}" MinWidth="88"
                                            VerticalAlignment="Center" Click="OnOpenExtensionMarket"/>
                                </Grid>

                                <!-- ⚠️ 点开之后**就在这里说**，不弹模态框：
                                     这一页本来就是静态的，一句话放在点击处最近的地方最好找。 -->
                                <TextBlock x:Name="ExtensionsNote" Style="{StaticResource Caption}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="520"
                                           Foreground="{StaticResource Warning}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ④ 高级设置
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
                        <!-- ── 启动与关闭（批次 9，照设计图 `_49`）─────────────
                             ⚠️ 设计图上这一页**只有这三行**，而 VidLog 的高级设置底下
                             还有分段、重复检测、时间校准、许可 —— 那几样是真能力
                             （图上是把它们挪进了配置向导），所以这里是**加在最上面**，
                             与「设备与外观」那一节同一个处理方式。
                             ⚠️ 第三行的说明**刻意没有照抄图上那句**
                             （图上写的是「启动器后台下载增量包，下次启动时自动安装」）：
                             需求方 2026-09-30 裁决「自动更新 = **只做检查 + 提示**，
                             不做启动器 exe、不自替换」。照抄那句就等于在界面上
                             承诺一件本程序**不会做**的事。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="开机自启动"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           Text="电脑开机后自动启动本程序。"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="RunAtStartupToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="OnRunAtStartupChanged"
                                          Unchecked="OnRunAtStartupChanged"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="关闭窗口时"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           Text="可以每次询问、最小化到托盘或直接退出。"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CloseActionCombo" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnCloseActionChanged"/>
                        </Grid>
                        <!-- ⚠️ 选「直接退出」时**必须**说清「在录的段怎么办」——
                             这条与托盘那条退出路是同一个行为，用户得知道它不会
                             悄悄把这一段扔掉。 -->
                        <TextBlock x:Name="CloseActionNote" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520"
                                   Text=""/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="自动检查更新"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           Text="启动后在后台问一句有没有新版本，有就在托盘上提示一句；不会自动下载、也不会替换本程序。检查结果见「关于」页。"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="CheckUpdateToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="OnCheckUpdateChanged"
                                          Unchecked="OnCheckUpdateChanged"/>
                        </Grid>

                        <!-- ── 配置向导（批次 3，照设计图 `_16`–`_34`）─────────────
                             ⚠️ 这颗按钮**原本在「设备与外观」**（紧挨着摄像头那两行）。
                             批次 G 照前身产品的分页搬到这里 —— 前身把
                             「配置向导 / 重新运行」放在高级设置，位置就在
                             「自动检查更新」之后（截图 `H:\_installers\shots\x-tab-9.png`）。
                             ⚠️ 「设备与外观」里那句「在【配置向导 → 选择摄像头】里改」
                             指向的仍是同一个入口 —— 那边留了一句指路，别把它删了。
                             ⚠️ 这是**搬**不是复制：`OpenWizardButton` 全仓只有这一个
                             （code-behind 的 `OnOpenWizard` 绑在它上面）。 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="配置向导"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           Text="一步步配好摄像头、摄像头识别、方向、麦克风、扫码枪，并当场跑一次录制性能检测。"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="OpenWizardButton" Content="打开配置向导"
                                    Style="{StaticResource SecondaryButton}" MinWidth="120"
                                    VerticalAlignment="Center" Click="OnOpenWizard"/>
                        </Grid>

                        <!-- ── 日志（2026-10-01 需求方要「级别可配」）──────────
                             ⚠️ 设计图上没有这两行 —— 这是**新要求**，不是偏离。
                             加在这里是因为「高级设置」本来就是给运维/排查用的那一节。 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="日志级别"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           Text="平时留在「信息」就够。在真机上排查问题时改成「调试」—— 改完立刻生效，不用重启，也不用等一个新版本。"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LogLevelCombo" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnLogLevelChanged"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                           Text="日志保留天数"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           Text="超过这个天数的日志会被删掉（按文件名里的时间戳算，不看文件的修改时间）。"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="LogRetainDaysBox" Width="80"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OnLogRetainDaysChanged"/>
                        </Grid>

                        <Separator Margin="0,18,0,16"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="分段与重复检测"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="分段时长（分钟）"
                                       Style="{StaticResource FieldLabel}" Width="130"/>
                            <TextBox x:Name="SegmentBox" Width="120"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="130,4,0,0"
                                   Text="单个分段的上限。到点自动滚下一段，用户无感。"/>

                        <!-- 重复单号检测（规格 §3.2.5：「N 可配置」）——
                             必须给得出「关掉」这个值，否则它在连续扫的工位上就是噪声。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="重复单号检测（天）"
                                       Style="{StaticResource FieldLabel}" Width="130"/>
                            <TextBox x:Name="DuplicateDaysBox" Width="120"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="130,4,0,0"
                                   Text="⚠️ 只提醒、不挡开录 —— 录制照常开始。填 0 关掉。"/>
                        <StackPanel Orientation="Horizontal" Margin="130,4,0,0">
                            <local:HelpTip
                                Text="扫到的单号若在这么多天内录过，会提醒你（气泡 + 语音）。它只提醒、不挡开录 —— 录制照常开始，你事后核对是不是重复录件或单号扫错了。"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0"
                                       Text="什么时候会提醒、提醒成什么样"/>
                        </StackPanel>

                        <Separator Margin="0,18,0,16"/>

                        <!-- 时间校准（规格 §3.6.4）。**未校准不能开始录制** ——
                             所以它必须说清三件事：为什么 / 怎么办 / 已有录像照常可用。 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="时间校准" Margin="0"/>
                            <local:HelpTip Margin="6,0,0,0"
                                           Text="为什么要它：视频里的时间必须能追溯到本机之外的某个来源 —— 靠本机时钟的话，改一下系统时间就能伪造「更早的证据」。联一次网取到时间之后，即使以后一直断网也能照常录制（时间是拿「校准那一刻 + 之后走了多久」推出来的，与系统时钟无关）。&#x0a;&#x0a;怎么办：点【重新校准】。取不到公网时间时，检查这台机器能不能上网（要能访问 https）。⚠️ 只有内网、从没联过公网的机器开不了工 —— 这是需求方 2026-09-24 明确接受的代价。"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="CalibrationNote" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="480"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <Button x:Name="CalibrateButton" Content="重新校准"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="12,0,0,0" Click="OnCalibrate"/>
                        </StackPanel>
                        <!-- ⚠️ 这一条**不折进「?」**：它说的是「没校准也不会怎样」，
                             不写出来用户会以为录像全废了。 -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="⚠️ 未校准只挡住新录：已有的录像照常可以检索、回放、导出、交付 —— 与许可那条红线（不得锁住已有录像）是同一条道理。"/>

                        <Separator Margin="0,18,0,16"/>

                        <!-- 许可（规格 §3.9 / `docs/04-许可设计.md`）。**只限机位** ——
                             未激活只挡住「开始新的录制」与「新的手机接进来」，
                             已有的录像一条都不锁（L8）。 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="许可（机位）" Margin="0"/>
                            <local:HelpTip Margin="6,0,0,0"
                                           Text="为什么要它：机位 = 允许接入的手机端台数（今天是「手机台数」，加上第二路相机时那一路也算一台）。没有服务端，所以是本机算出一串机器码 → 你给提供方 → 他签发一个激活码 → 在这里粘回来。&#x0a;&#x0a;怎么办：把下面那串机器码抄给提供方，拿到激活码之后粘进下面的框、点【激活】。⚠️ 换主板或刷过 BIOS 之后机器码会变，需要重新签发。&#x0a;&#x0a;⚠️ 校验只在启动时做一次：录到一半改了什么，也要重启之后才生效 —— 那是为了不把正在录的那一段掐掉。"/>
                        </StackPanel>

                        <TextBlock x:Name="LicenseNote" Style="{StaticResource Body}"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="本机机器码（抄给提供方，用来签发这台机器的激活码）"
                                   Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox x:Name="MachineCodeBox" Width="330" IsReadOnly="True"
                                     FontFamily="{StaticResource MonoFont}"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="CopyMachineCodeButton" Content="复制"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,5" Margin="8,0,0,0"
                                    Click="OnCopyMachineCode"/>
                        </StackPanel>

                        <TextBlock Text="激活码（提供方签发的那一串，整段粘进来就行）"
                                   Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox x:Name="ActivationBox" Width="330"
                                     FontFamily="{StaticResource MonoFont}"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="ActivateButton" Content="激活"
                                    Style="{StaticResource PrimaryButtonStrong}"
                                    Padding="16,5" Margin="8,0,0,0"
                                    Click="OnActivate"/>
                        </StackPanel>

                        <!-- ⚠️ 这一条**不折进「?」**：它是 L8 那条红线在界面上的落点
                             （「用户的数据是他的，不是人质」），必须直接看得见。 -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="⚠️ 未激活只挡住新的录制和新的手机接入：已有的录像照常可以检索、回放、导出、交付。已经接进来的手机也照样上传，不会被打断。"/>
                    </StackPanel>

                    <!-- ────────────────────────────────────────────────
                         ⑤ 关于
                         ⚠️ 这里只放**真读得出来**的东西（规格 §13.1）。
                         ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="本机"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}"
                                       Text="版本" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersionText"
                                       Style="{StaticResource Body}" Text="…"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="录制规格" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutSpecText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="回放服务" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutServerText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="归档层" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AboutArchiveText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="数据目录" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AboutDataDirText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Text="…"/>

                            <!-- ⚠️ 第 5 行给「检查更新」的结论（设计图 `_49` 那一行的落点）。
                                 查不到时说「没查到」而**不是**说「已是最新」—— 那两件事
                                 不一样，混起来会让用户以为自己的版本是最新的。 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="更新检查" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AboutUpdateText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Text="…"/>
                        </Grid>

                        <Button x:Name="OpenDataFolderButton" Content="打开数据目录"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Click="OnOpenDataFolder"/>

                        <Separator Margin="0,18,0,16"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="诊断包"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="把日志、设置与环境信息打成一个 zip，不含任何视频。"/>
                        <Button x:Name="ExportDiagnosticsButton" Content="导出诊断包"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="OnExportDiagnostics"/>

                        <!-- 启动时的问题（`AppHost.Warnings`）。**必须看得见** ——
                             它们在启动那一刻就发生了，而用户多半没盯着屏幕。 -->
                        <TextBlock Text="启动时需要注意" Style="{StaticResource SectionTitle}"
                                   Margin="0,20,0,8"
                                   x:Name="WarningsHeader" Visibility="Collapsed"/>
                        <!-- ⚠️ **不给 MaxHeight**：这一页整页已经在一个 `ScrollViewer`
                             里，再限一次高度只会让第 3、4 条被自己的滚动条裁掉
                             （2026-10-02 实测报上来的）。没上界时它按内容长、由外层的
                             滚动条统一管。 -->
                        <ListBox x:Name="WarningsList"
                                 HorizontalContentAlignment="Stretch"
                                 Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ══ 底部：状态 + 确定 / 应用 / 取消 ════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                    Padding="28,14">
                <!-- ⚠️ **两列，不要把它俩摞在同一个格子里**。原来是一格放两个
                     （文字左对齐 + `MaxWidth="480"`，按钮右对齐），看着像有宽度上限，
                     其实那 480 只约束文字自己 —— 这一句一长就伸到按钮底下，
                     被后画的按钮**盖住**，右边半句看不见（2026-10-02 实测：
                     「……其余」后面直接没了）。给按钮一列、文字拿剩下的那一列，
                     宽度就由版式算出来，不用猜数字。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SettingsStatus" Grid.Column="0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,16,0"
                               Foreground="{StaticResource TextSecondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OkButton" Content="确定"
                                Style="{StaticResource PrimaryButtonStrong}"
                                MinWidth="88" Click="OnOk"/>
                        <Button x:Name="ApplyButton" Content="应用"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="88" Margin="8,0,0,0" Click="OnApply"/>
                        <Button x:Name="CancelButton" Content="取消"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="88" Margin="8,0,0,0" Click="OnCancel"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
