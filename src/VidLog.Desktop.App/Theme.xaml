<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ════════════════════════════════════════════════════════════════
        电脑端设计语言（SaaS 版式，2026-09-28）

        ⚠️ 色值直接沿用需求方自己那个布局画板的调色板
        （`H:\LayoutBoard\Model.cs:166-173`）—— 这样界面与他画草图时
        用的是同一套颜色，不会出现「画的是一套、做出来是另一套」。

        ⚠️ 洁净室（`AGENTS.md` §0）：这一套是**按需求方口述的四条**
        （左侧竖导航 / 新增概览 / 中性灰底 + 蓝点缀 / 收进「?」）
        加上通用版式惯例推出来的，**没有参照任何第三方产品的界面**。

        ⚠️ 有意不做的：`ComboBox` / `TextBox` / `DataGrid` / `DatePicker`
        都**不重写 `ControlTemplate`**。重写这四个是几百行，而且极易踩出
        「下拉打不开」「日期选不了」这类**只有跑起来才看得见**的毛病。
        它们保持 Windows 原生长相 —— 这是取舍，不是没做完。
        （`NavItem` 与两个按钮重写了模板：前者本来就只是个
        Border + ContentPresenter；后者是界面上最显眼的控件，
        套默认 chrome 的话蓝色底会跟系统渐变打架。）
        ════════════════════════════════════════════════════════════════
    -->

    <!-- ── 颜色 ──────────────────────────────────────────────────── -->
    <Color x:Key="PageBackgroundColor">#FFF5F5F5</Color>
    <SolidColorBrush x:Key="PageBackground" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF212121"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF616161"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#FF9E9E9E"/>
    <SolidColorBrush x:Key="Accent" Color="#FF1E88E5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF1976D2"/>
    <SolidColorBrush x:Key="AccentWeak" Color="#FFE3F2FD"/>
    <SolidColorBrush x:Key="Success" Color="#FF43A047"/>
    <SolidColorBrush x:Key="Warning" Color="#FFFB8C00"/>
    <SolidColorBrush x:Key="WarningSurface" Color="#FFFFF8E1"/>
    <SolidColorBrush x:Key="Danger" Color="#FFE53935"/>

    <!--
        字体只用**系统自带**的，不引任何字体/图片素材文件 ——
        本仓至今一张资源文件都没有（托盘图标还是借系统的），这条保持。
        微软雅黑排中文比 Segoe UI 明显好，放在最前面。
    -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Microsoft YaHei UI</FontFamily>

    <!-- ── 文字 ──────────────────────────────────────────────────── -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 说明文字。**原来这些地方是满屏重复的 `Foreground="#88666666"`。** -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--
        空值行：文本为空时**整行收掉**。

        ⚠️ 为什么需要它：`Auto` 高度的行里，一个空的 TextBlock **仍然占一行高**
        —— 「待办」卡上「待清理」「未备份逾期」两行的值多数时候是空的，
        于是卡片上会挂两条什么都没有的空白（2026-09-28 截图里看出来的）。
        收掉值那一格还不够：左边的标签得跟着一起走，所以标签那边
        用 `Visibility="{Binding ElementName=…, Path=Visibility}"` 跟着值走。
    -->
    <Style x:Key="ValueLine" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionLine" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 标签列。原来是每处手写 `Width="66"`，现在一个样式收口。 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Width" Value="76"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── 卡片 ──────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ── 按钮 ──────────────────────────────────────────────────── -->
    <!--
        重写模板的理由：默认 Button 的 chrome 是系统渐变 + 系统边框，
        自定 Background 之后蓝色底会和它打架（悬停/按下时尤其明显）。
        这两个模板只做「圆角 + 底色 + 悬停/按下/禁用三态」，不碰内容呈现。
    -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource TextDisabled}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource AccentWeak}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SurfaceMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 左侧导航项 ────────────────────────────────────────────── -->
    <!--
        用 RadioButton 而不是 Button/ToggleButton：**互斥是白送的**
        （同一个 GroupName 自动单选），不用自己维护「当前选中谁」。
        选中态 = 浅蓝底 + 蓝色文字 + 左侧一条蓝色指示条。
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                            Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左侧指示条：默认透明，选中才上蓝色 -->
                            <Border x:Name="Bar" Grid.Column="0" Width="3" Height="16"
                                    CornerRadius="2" Background="Transparent"
                                    HorizontalAlignment="Left" Margin="-8,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SurfaceMuted}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource AccentWeak}"/>
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
