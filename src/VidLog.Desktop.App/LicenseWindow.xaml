<Window x:Class="VidLog.Desktop.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VidLog 7 天试用"
        Width="700" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource PageBackground}">
    <!--
        ════════════════════════════════════════════════════════════════
        两个场合共用这一张窗（需求方 2026-10-17 的裁定）

          · 首次运行：说明 7 天试用 + 给出机器码 + 二维码/邮箱
                      → 【我已了解，同意】/【不同意，退出程序】
          · 试用到期后的购买引导：同一份机器码与二维码，只有一个【关闭】

        ⚠️ **窗口里不放激活输入框**：需求方说的是「我拿到机器码后给用户，
        让用户手动激活」—— 激活那一步在【设置 → 许可】里做（那里同时
        显示校验失败的原因）。这里再放一个输入框等于两份激活路径。
        ⚠️ 二维码那张图与「关于」页是**同一份文件**（`contact-qr.png`，
        编进程序集）：换人只换那张图，别改这里的代码。
        ⚠️ 图底下那圈白底是必须的：二维码要靠四周静区才扫得出来，
        暗色主题下不垫白底就是一个深底黑块。
        ════════════════════════════════════════════════════════════════
    -->
    <StackPanel Margin="34,22,34,0">
        <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitle}"
                   Text="本程序提供 7 天试用"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource BodySecondary}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <!-- ── 机器码 ───────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                           Text="这台电脑的机器码"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="发给提供方换激活码，到【设置 → 许可】粘贴。"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="MachineCodeBox" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="{StaticResource TextSizeBody}"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="CopyButton" Content="复制" Margin="10,0,0,0"
                            Padding="18,6" Style="{StaticResource SecondaryButton}"
                            Click="OnCopyMachineCode"
                            AutomationProperties.Name="复制机器码"/>
                </Grid>
                <TextBlock x:Name="DegradedText" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ── 联系方式 ─────────────────────────────────────────── -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="8"
                    CornerRadius="{StaticResource RadiusControl}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <Image Source="contact-qr.png" Width="150" Height="150"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                           Text="微信扫码加我们"/>
                <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Text="发来机器码换试用码；邮件 vidlog@126.com"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="到期后不能再录；已有录像照常检索、回放、导出。"/>
            </StackPanel>
        </Grid>

        <!-- ── 底部按钮 ─────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,22">
            <!-- ⚠️ `IsCancel="True"` 是**必须的**（有那条「每个对话框都按 Esc 关得掉」的
                 测试钉着）：没有它，按 Esc 对这个模态框毫无反应 —— 而首次运行那一屏
                 正是用户第一次遇到它、最会乱按键的时候。
                 首次运行时 Esc 等于「不同意」⇒ 退出程序，与按钮同一条路。 -->
            <Button x:Name="DeclineButton" Content="不同意，退出程序" Padding="20,8"
                    Style="{StaticResource SecondaryButton}" Click="OnDecline" IsCancel="True"
                    AutomationProperties.Name="不同意并退出程序"/>
            <Button x:Name="AcceptButton" Content="我已了解，同意" Padding="20,8" Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnAccept" IsDefault="True"
                    AutomationProperties.Name="同意并继续"/>
        </StackPanel>
    </StackPanel>
</Window>
