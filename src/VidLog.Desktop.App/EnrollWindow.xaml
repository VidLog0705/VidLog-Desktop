<Window x:Class="VidLog.Desktop.App.EnrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接电脑 / 手机" Height="640" Width="470"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="手机端扫下面这张二维码来申请连接。申请到了之后，屏幕正中会弹出提示，由你决定同意还是拒绝。"/>

        <!-- 发不出码的时候这里会说清楚为什么（服务没起来 / 只绑了本机 / 没有局域网地址）。
             不说的话，用户看到的就是一张扫不动的码。 -->
        <TextBlock Grid.Row="1" x:Name="BlockerText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#CCB00020" Visibility="Collapsed"/>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10" Background="White"
                BorderBrush="#33000000" BorderThickness="1" CornerRadius="4"
                HorizontalAlignment="Center">
            <!-- 一个模块一个像素，靠最近邻放大成方块。
                 用别的方式缩放会把模块边缘糊成灰边 —— 糊掉的码在屏幕上看着正常、扫不出来。 -->
            <Image x:Name="QrImage" Width="280" Height="280" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusLine" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="AddressLine" Margin="0,4,0,0" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#88666666"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="已经连过的设备" FontWeight="SemiBold"/>
            <ListBox x:Name="DeviceList" Margin="0,4,0,0" Visibility="Collapsed"
                     HorizontalContentAlignment="Stretch"/>
            <TextBlock x:Name="DeviceEmpty" Margin="0,4,0,0" Foreground="#88666666"
                       TextWrapping="Wrap" Text="还没有设备连过这台电脑。"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="RegenerateButton" Content="重新生成二维码" Padding="16,6"
                    Click="OnRegenerate"/>
            <Button Content="关掉" Padding="16,6" Margin="8,0,0,0" Click="OnClose"/>
            <TextBlock x:Name="FootNote" Margin="12,0,0,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#88666666"/>
        </StackPanel>
    </Grid>
</Window>
