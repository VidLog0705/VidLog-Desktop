<Window x:Class="VidLog.Desktop.App.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="打包数据深度分析" Height="760" Width="1100" MinWidth="880" MinHeight="600"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource PageBackground}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
        ════════════════════════════════════════════════════════════════
        打包数据深度分析（照需求方设计图 `_40`）

        ▓▓ 版式 ▓▓
          第一行：时间范围（下拉 + 两个日期）· 查看维度（三选一）· 聚合方式（下拉）
          第二行：四张统计卡
          第三行：图（横向条形，一行一个时间桶）

        ⚠️ 图上那一大块图表区在截图里是空的（那份数据是 0 条），所以**柱子的样子
        图上没有**。这里做成横向条形：一行一个桶，左边日期、中间条、右边数值。
        竖柱状图要自己画坐标轴与网格线，而**信息一模一样** —— 不值得。
        这是取舍，不是没做完。

        ⚠️ **只画能从索引算出来的东西**（规格 §13.1）。图上这类页常见的
        「上传成功率」「订单按时率」本仓算不出来（订单联动要服务端 M6），
        这里没有，**也不许编一个**。

        ⚠️ 条形用的是 `ProgressBar` 而不是自己搭两列 Grid：
        `ColumnDefinition` **不继承 DataContext**，在里面绑 `Width` 是个经典的哑巴坑
        （绑不上、不报错、条永远是满的）。`ProgressBar` 的 `PART_Indicator`
        由控件自己按 `Value/Maximum` 算宽度，天然自适应窗口缩放。

        ⚠️ 所有金额式的数**都带「约」** —— 字节数是按录制规格推算的，
        不是 stat 出来的（`CleanupPlanner.EstimateBytes` 那段注释写着为什么）。
        ════════════════════════════════════════════════════════════════
    -->
    <Window.Resources>
        <!--
            分段选择（数量 / 时长 / 大小）。照 `_40`：选中的那块是**蓝底白字**，
            未选中是白底 + 灰描边。

            用 RadioButton 而不是三个 Button：**互斥由 GroupName 白送**，
            不用自己维护「现在选的是谁」以及三处 IsEnabled 的联动。

            ⚠️ 没有放进 `Theme.xaml`：目前只有这一个窗口用它。等第二个窗口
            也要了再搬上去 —— 提前搬的话，等真要用时它的形状多半还是错的。
        -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                CornerRadius="6" Padding="14,5" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceMuted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSolid}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentSolid}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- ⚠️ 多店铺分组那个占位（需求方 2026-10-01：只留入口）。 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 筛选条 ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="时间范围:" VerticalAlignment="Center"
                           Style="{StaticResource Body}"/>

                <ComboBox x:Name="RangeCombo" Width="110" Margin="8,0,0,0"
                          SelectedIndex="0" SelectionChanged="OnRangeChanged">
                    <ComboBoxItem Tag="7">最近 7 天</ComboBoxItem>
                    <ComboBoxItem Tag="30">最近 30 天</ComboBoxItem>
                    <ComboBoxItem Tag="90">最近 90 天</ComboBoxItem>
                    <ComboBoxItem Tag="month">本月</ComboBoxItem>
                    <ComboBoxItem Tag="custom">自定义</ComboBoxItem>
                </ComboBox>

                <DatePicker x:Name="FromDate" Width="130" Margin="10,0,0,0"
                            SelectedDateChanged="OnDateChanged"/>
                <TextBlock Text="—" Margin="6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
                <DatePicker x:Name="ToDate" Width="130"
                            SelectedDateChanged="OnDateChanged"/>

                <TextBlock Text="查看维度:" VerticalAlignment="Center" Margin="24,0,0,0"
                           Style="{StaticResource Body}"/>
                <RadioButton x:Name="DimCount" Content="数量" GroupName="Dim" Tag="count"
                             IsChecked="True" Style="{StaticResource SegmentButton}"
                             Checked="OnDimensionChanged"/>
                <RadioButton x:Name="DimDuration" Content="时长" GroupName="Dim" Tag="duration"
                             Style="{StaticResource SegmentButton}"
                             Checked="OnDimensionChanged"/>
                <RadioButton x:Name="DimBytes" Content="大小" GroupName="Dim" Tag="bytes"
                             Style="{StaticResource SegmentButton}"
                             Checked="OnDimensionChanged"/>

                <TextBlock Text="聚合方式:" VerticalAlignment="Center" Margin="24,0,0,0"
                           Style="{StaticResource Body}"/>
                <ComboBox x:Name="GranularityCombo" Width="96" SelectedIndex="0"
                          SelectionChanged="OnGranularityChanged">
                    <ComboBoxItem Tag="Day">按日</ComboBoxItem>
                    <ComboBoxItem Tag="Week">按周</ComboBoxItem>
                    <ComboBoxItem Tag="Month">按月</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ══ 四张统计卡 ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="打包总件数"/>
                    <TextBlock x:Name="TotalCountText" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{DynamicResource TextPrimary}"
                               Text="0"/>
                    <!-- ⚠️ 两个口径都给出来：一个单号可以有好几段录像，
                         只说一个数的话「件」这个词是含糊的。 -->
                    <TextBlock x:Name="TotalWaybillsText" Style="{StaticResource Caption}"
                               Margin="0,2,0,0" Text=""/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="占用存储空间"/>
                    <TextBlock x:Name="TotalBytesText" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{DynamicResource Accent}"
                               Text="约 0 MB"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="累计工作时长"/>
                    <TextBlock x:Name="TotalDurationText" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{DynamicResource Success}"
                               Text="0 秒"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18,14" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="平均单件用时"/>
                    <TextBlock x:Name="AverageText" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{DynamicResource Warning}"
                               Text="0 秒"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ 图 ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock x:Name="ChartTitleText" Style="{StaticResource SectionTitle}"
                               Margin="0" Text="按日 · 数量"/>
                    <TextBlock x:Name="ChartStatusText" Style="{StaticResource Caption}"
                               Margin="12,0,0,0" VerticalAlignment="Center" Text="正在统计…"/>
                </StackPanel>

                <!-- ⚠️ 没有录像时**不能只留一块空卡片**：一块大白框看上去像
                     「还在加载」或者「坏了」，而实际是「这段时间没录」——
                     那是三种完全不同的处境。空态那句话由 code-behind 开关。 -->
                <TextBlock x:Name="BucketEmptyText" Grid.Row="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Visibility="Collapsed"
                           Text="这段时间里没有录像。把时间范围放宽一点再看看。"/>

                <ScrollViewer x:Name="BucketScroll" Grid.Row="1" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BucketList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"/>

                                    <!-- 条：见文件头那段关于 ProgressBar 的说明 -->
                                    <ProgressBar Grid.Column="1" Height="10"
                                                 VerticalAlignment="Center" Margin="8,0"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Ratio, Mode=OneWay}"
                                                 Foreground="{DynamicResource AccentSolid}"
                                                 Background="{DynamicResource SurfaceAlt}"
                                                 BorderThickness="0">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5" SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Border x:Name="PART_Track"/>
                                                        <Border x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="5"
                                                                Background="{TemplateBinding Foreground}"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>

                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ⚠️ 「只列有录像的」必须写出来：不写的话一条断掉的时间轴
                     会被当成连续的，而用户会以为中间那些天「没录上」。 -->
                <TextBlock Grid.Row="2" x:Name="ChartFootnoteText"
                           Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="只列出有录像的时间段。存储大小是按录制规格推算的约数，不是实测。"/>
            </Grid>
        </Border>

        <!-- ⚠️ 多店铺分组（`IMPLEMENTATION.md` M8 一行名字，零规格）。
             需求方 2026-10-01：**只留入口**。摆在这一页是**我挑的**
             （它是按店铺分组看数据，属于这一页的语义），设计图上没有它 —— 要挪说一声。 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                               Text="多店铺分组"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxWidth="520"
                               Text="把录像按店铺分开统计、分开看。"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="ShopGroupingButton" Content="打开"
                        Style="{StaticResource SecondaryButton}" MinWidth="88"
                        VerticalAlignment="Center" Click="OnOpenShopGrouping"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="ShopGroupingNote" Style="{StaticResource Caption}"
                   Margin="2,8,0,0" TextWrapping="Wrap" MaxWidth="620"
                   Foreground="{DynamicResource Warning}" Visibility="Collapsed"/>
    </Grid>
</Window>
