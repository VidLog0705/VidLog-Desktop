<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ════════════════════════════════════════════════════════════════
        电脑端设计语言（照需求方自绘界面图，2026-09-28）

        ⚠️ 这套色值**不是估的**，是从需求方那 32 张设计图里**逐像素量**出来的
        （`System.Drawing` 采样指定矩形取众数，只统计有色像素）。
        整套是 **Tailwind** 色板，量到的原值见 `docs/实现决策.md` §60。
        上一版那套 Material 蓝（`#1E88E5`，取自 `H:\LayoutBoard\Model.cs`）
        与更早那版 SaaS 外观**整表作废**。

        ⚠️ ~~**两套蓝并存是需求方的裁决**（2026-09-28，原话「严格照图」）：
        主窗口用 `Accent` = blue-500 `#3B82F6`，设置窗口的主按钮用
        `AccentStrong` = blue-600 `#2563EB`。图上就是这样，**不要为了
        「统一」把它合并成一个**——已问过，答案是照图。~~
        → **2026-10-07 需求方推翻它，裁定合并成一套**：`Accent` = blue-600
        `#2563EB`，`AccentStrong` 删除。理由**不是**「统一好看」，是**对比度**：
        白字 13px 压 blue-500 只有 3.68:1、低于 AA 的 4.5:1，压 blue-600 是
        5.17:1。与手机端 2026-10-04「放弃照草图原值、改为深色化到达标」同一把尺子。

        ⚠️ 洁净室（`AGENTS.md` §0）：这批图是需求方自绘/自有的界面，
        2026-09-28 已**书面豁免**「不得参照第三方产品界面」这一条，
        豁免范围**只限界面外观**（留档见 `docs/实现决策.md` §59）。
        代码、密钥做法、架构**没有被豁免**。

        ⚠️ 有意不做的：`ComboBox` / `TextBox` / `DataGrid` / `DatePicker`
        都**不重写 `ControlTemplate`**。重写这四个是几百行，而且极易踩出
        「下拉打不开」「日期选不了」这类**只有跑起来才看得见**的毛病。
        它们保持 Windows 原生长相，只用普通 Setter 逼近配色 ——
        这是取舍，不是没做完。
        （`NavItem` 与几个按钮重写了模板：前者本来就只是个
        Border + ContentPresenter；后者是界面上最显眼的控件，
        套默认 chrome 的话蓝色底会跟系统渐变打架。）

        ⚠️ 字号（20/14/13/12）是**相对关系**保留原来的，没有绝对标定 ——
        截图 DPI 未知，量不出 pt。做具体窗口时对着图微调。

        ⚠️ **2026-10-07 起，取颜色一律写 DynamicResource，不许再写
        StaticResource。** 第 5 批要跟随系统切暗色，而
        StaticResource 在加载那一刻就把值定死 —— 连 `Style` 里的 `Setter` 也一样
        （实测：换完主题字典，新建控件的 `PrimaryButton` 底色**仍是亮色那支**）。
        暗色的值在 `VidLog.Desktop.Core/Theme/ThemePalette.cs`，
        由 `Platform/AppTheme.cs` 在启动时合并成一份覆盖字典。
        字号 / 圆角 / 字体这些**不随主题变**的仍照旧用 `StaticResource`。
        （全仓 268 处颜色引用已按此改完；绊线是
        `ThemePaletteTests.每一处DynamicResource都找得到定义` ——
        动态资源找不到是**静默不生效**，不像静态资源那样当场就崩。）
        ════════════════════════════════════════════════════════════════
    -->

    <!-- ── 颜色（Tailwind，全部量自设计图） ──────────────────────── -->

    <!-- 页面底：gray-100。主窗 / 向导 / 多画面，图上占 15–91%。 -->
    <Color x:Key="PageBackgroundColor">#FFF3F4F6</Color>
    <SolidColorBrush x:Key="PageBackground" Color="#FFF3F4F6"/>

    <!-- ⚠️ 设置窗左侧导航区**不是**页面底色的灰，是 slate-50 —— 图上量出来的。
         「选中项右边空底 = FFFFFF / 未选中项空底 = F8FAFC」这条对比
         决定了选中态长什么样：**选中的那块是白的、浮在浅灰侧栏上**，
         不是「浅蓝底 + 蓝字」。 -->
    <SolidColorBrush x:Key="SidebarBackground" Color="#FFF8FAFC"/>

    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>

    <!-- 次级区块：slate-50。向导内容卡、只读输入框。 -->
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FFF8FAFC"/>

    <!-- 底部统计条：slate-100（`_35` 底栏）。比页面底浅一档，压在页面上。 -->
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FFF1F5F9"/>

    <!-- 1px 描边：slate-200。卡片、面板。 -->
    <SolidColorBrush x:Key="CardBorder" Color="#FFE2E8F0"/>

    <!-- 输入框与次级按钮的描边：slate-300。比卡片边深一档。 -->
    <SolidColorBrush x:Key="BorderStrong" Color="#FFCBD5E1"/>

    <!-- 正文 slate-800；深色面板上的标题用 slate-900（见 VideoBackground）。 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1E293B"/>
    <!--
        ⚠️ **2026-10-07 需求方拍板改过一次值**：原为 slate-500 `#64748B`，
        压在页面底 `#F3F4F6` 上只有 **4.32:1**、低于 AA 正文档的 4.5:1
        （它是 `Caption` 那一档说明文字的主色，用得最广）。
        现值 `#59677C` 是把 slate-500 **顺着同色相压暗**量出来的
        （页底 **5.22:1**、卡片 **5.74:1**、选中底 `#DBEAFE` **4.71:1**），
        **不是 Tailwind 现成的一档** —— slate-600 `#475569` 会跳到 6.89:1，
        说明文字与正文的分层就没了。这条与 `AccentDisabled` 同例：
        色板以 Tailwind 为底，达标优先时按同色相微调，改了就写在这儿。
    -->
    <SolidColorBrush x:Key="TextSecondary" Color="#FF59677C"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#FF94A3B8"/>

    <!-- 主按钮、选中导航、单选点：blue-600。
         ⚠️ 2026-10-07 需求方拍板：**两套蓝合并成这一套**（原 blue-500 `#3B82F6`
         与 blue-600 `#2563EB` 并存）。留下的是**深的那一支**，理由是**对比度**：
         按钮是白字 13px（见下面的模板），白字压 blue-500 只有 **3.68:1**、
         低于 WCAG AA 正文档的 4.5:1；压 blue-600 是 **5.17:1**，达标。
         原 `AccentStrong` 连同 `PrimaryButtonStrong` 一并删除（它只服务 3 处）。 -->
    <SolidColorBrush x:Key="Accent" Color="#FF2563EB"/>
    <!--
        ⚠️ **`Accent` 与 `AccentSolid` 亮色下同值，暗色下不同** —— 这支是给
        「当**实心底**用」的地方（主按钮底、开关轨道、TagPill 底），上面会压白字。
        拆它的理由**不是**好看，是暗色下这两个角色要的值相反：
        当底必须留住 blue-600（白字 5.17:1，就是 P2 那次裁定保住的那条），
        当前景压在 slate-800 上只有 2.83:1 —— 连图形要的 3:1 都不到。
        暗色的两支值见 `VidLog.Desktop.Core/Theme/ThemePalette.cs`。
        （亮色同值 ⇒ 这次拆分**不改变亮色的任何一个像素**。）
    -->
    <SolidColorBrush x:Key="AccentSolid" Color="#FF2563EB"/>
    <!-- 选中卡片底：blue-100。 -->
    <SolidColorBrush x:Key="AccentWeak" Color="#FFDBEAFE"/>
    <!-- 主按钮禁用态：blue-500 兑白，图上 `_31` 的「下一步」。 -->
    <SolidColorBrush x:Key="AccentDisabled" Color="#FF8EB5F6"/>
    <!--
        禁用态主按钮上那行字的墨色。
        ⚠️ 拆这一支不是为了好看，是**暗色下原来那个写死的白字比可用态还醒目**：
        暗色禁用底 `#1E3A8A` 压纯白是 **10.36:1**，而可用底 blue-600 压白只有
        **5.17:1** —— 「禁用」反而最清楚。亮色没这个毛病（禁用底是淡蓝，
        白字只有 2.08:1），所以**亮色就用原来的白**：这一支亮色取 `#FFFFFF`
        ⇒ 拆分**不改变亮色的任何一个像素**。暗色取 `TextDisabled` 那一档。
        绊线见 `ThemePaletteTests.禁用态不许比可用态还显眼`。
    -->
    <SolidColorBrush x:Key="PrimaryDisabledInk" Color="#FFFFFFFF"/>
    <!--
        进度条的**填充**（向导进度、麦克风电平、容量条、启动窗那条）。
        ⚠️ 与 `AccentSolid` 分开的**唯一**理由是暗色：这四条进度条的**轨道**
        各用各的键（`AccentWeak` / `SurfaceAlt` / `SurfaceMuted` / `BorderStrong`），
        暗色下这四块面的亮度与 blue-600 差得太小 —— 量出来只有 **1.47–3.45:1**，
        最坏那条（容量条压 `BorderStrong`）等于看不出填充（图形要 3.0）。
        所以暗色那支换成跟这些轨道配套的 blue-300（**4.20–9.90:1**）。
        亮色取 `#2563EB`（与 `AccentSolid` 同值）⇒ **不改变亮色**。
        四条的实际配对照 `ThemePaletteTests.进度填充压轨道每一对都达标`（亮暗各量一次）。
    -->
    <SolidColorBrush x:Key="ProgressFill" Color="#FF2563EB"/>

    <!-- 「开始录制」按钮：emerald-500。 -->
    <SolidColorBrush x:Key="Success" Color="#FF10B981"/>

    <!--
        ⚠️ **2026-10-07 需求方拍板改过一次值**：原为 amber-500 `#F59E0B`。
        它有两副面孔，**两副原来都不达标**：
          · 当**文字**（`Foreground`；XAML 里 **10 处**，另有 C# 那几支）压在卡片白底上只有 **2.15:1**；
          · 当 `WarningSurface` 那块的**描边**压在 `#FFFBEB` 上只有 **2.07:1**。
        现值 `#C2410C`（orange-700）白底 **5.18:1**、警示底上 **4.99:1**，两副都过。
        ⚠️ 这不是新挑的颜色：**网页回放页（`PlaybackServer.Page.cs` 里那个名为
        `warn` 的 CSS 变量，CSS 自定义属性要写两个减号打头）一直用的就是它**。
        同一套语义在仓里本来就有两个值，这次是让 WPF 这边
        对齐到**达标的那个**。
        暗色那支仍是 `#F59E0B`（暗底上 6.81:1，本来就够），见 `ThemePalette.Dark`。
    -->
    <SolidColorBrush x:Key="Warning" Color="#FFC2410C"/>
    <SolidColorBrush x:Key="WarningSurface" Color="#FFFFFBEB"/>

    <!--
        ⚠️ 这一档在 32 张设计图里**没有出现过**（没找到任何红字/红底）。
        取 Tailwind red-500，与整套色板同源 —— 不是从图上量的，
        写在这里是为了不让下一个人以为它是量出来的。
    -->
    <SolidColorBrush x:Key="Danger" Color="#FFEF4444"/>

    <!-- 预览区深底：slate-900。`_35` 的录制预览就是它。 -->
    <SolidColorBrush x:Key="VideoBackground" Color="#FF0F172A"/>

    <!--
        预览区上浮着的那块半透明提示方块。slate-800 兑到 80% 不透明 ——
        图上量到的就是一个**带透明的**色，不是不透明色的另一种写法。
        ⚠️ 它压在 `VideoBackground` 上，两者相差只有一档；换底色时这块要跟着复核。
    -->
    <SolidColorBrush x:Key="OverlayPillBackground" Color="#CC1E293B"/>

    <!--
        交互叠加层：悬停 / 按下时**叠在底色上**的一层半透明色。

        ⚠️ 原来是写死在两个 `ControlTemplate` 里的字面量（`#1F000000` 这类），
        依据是「叠一层半透明黑，对任何底色都成立」—— 那正是它能一套模板服务
        两套蓝的原因（见 `PrimaryButton` 上面那段）。
        **但这条规律在暗色下不成立**：半透明黑压在深底上等于没压，悬停与按下
        会**看不见**。所以提成资源，暗色那边换成半透明白
        （见 `ThemePalette.Dark`）。`HoverOverlaySoft` 是次级按钮悬停那支更淡的。
    -->
    <SolidColorBrush x:Key="HoverOverlay" Color="#1F000000"/>
    <SolidColorBrush x:Key="HoverOverlaySoft" Color="#0F000000"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#33000000"/>

    <!--
        投影色。`DropShadowEffect.Color` 要的是 `Color` 而不是 `Brush`，所以这条
        不是上面那种 `SolidColorBrush`。**投影不参与主题**（暗色主题下投影仍是黑的），
        放这里只是让「除 Theme.xaml 外零处 hex」这条绊线成立。
    -->
    <Color x:Key="ShadowColor">#FF000000</Color>

    <!--
        字体只用**系统自带**的，不引任何字体/图片素材文件 ——
        本仓至今一张资源文件都没有（托盘图标还是借系统的），这条保持。
        微软雅黑排中文比 Segoe UI 明显好，放在最前面。
    -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Microsoft YaHei UI</FontFamily>

    <!-- ── 圆角 ──────────────────────────────────────────────────── -->
    <!--
        ⚠️ 这三支的值是**数出来的，不是拍的**（2026-10-04）：
        把 App 下 9 个 `.xaml` 里的 `CornerRadius=` 全数一遍 ——
        6 出现 **16** 次、8 出现 **14** 次、4 出现 **5** 次，
        再往后就是断崖（5 两次，3 / 9 / 11 各一次）。
        前三档各有一个角色，剩下的没有角色、只有偏差。

        ⚠️ 与 `docs/` 里那份改造报告对不上，两处：
        它写「卡片 10、弹窗 14」，而**本仓的卡片本来就是 8**
        （`Card` 样式就在下面）、**14 在全仓一次都没出现过**。
        这里按量到的值落，不按报告里的数落 —— 那份数没在代码里核过。

        ⚠️ `ToggleSwitch` 那个 `CornerRadius="11"` **故意不进令牌**：
        它是 `Height / 2`（高 22 的胶囊），是**算出来的**不是选出来的；
        给它编一个令牌，等于把「22 的一半」抄成一个看起来可调的数。
        **同一条规矩适用于所有 `ControlTemplate` 内部**，见 `RadiusTab` 上面那段。
    -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusTag">4</CornerRadius>

    <!--
        表头那种「上圆下直」——设置窗里两块存储路径表用的（`SettingsWindow.xaml`
        两处），是**一支真令牌**不是拼出来的：`<CornerRadius>` 是一整个值，
        没法拿 `RadiusTag` 再改两个角。
    -->
    <CornerRadius x:Key="RadiusTab">4,4,0,0</CornerRadius>

    <!-- ── 文字 ──────────────────────────────────────────────────── -->
    <!--
        ═══ 字号档位（2026-10-09）═══

        下面那批 `Style` 说的是**整套文字外观**（字族 + 字号 + 字重 + 颜色 + 换行），
        只能挂在 `TextBlock` 上。可是 App 里还有一批地方只要**一个字号**：
        `TextBox`/`Button`/`ComboBox` 挂不上 TextBlock 样式，而 C# 里 new 出来的
        `TextBlock` 也只想要那一档数。此前那 57 处是**手写数字**（26/22/15/14/13/12/11），
        于是「大号统计数字」这个角色在两个窗口里是 26 和 22 两个值、「卡片小标题」
        在 14 和 15 之间摇摆 —— 谁也没错，因为根本没有名字可以引。

        这几支就是那些档位的名字。它们**只管字号**，所以把 57 处迁过来时
        除了下面这两处**有意**的合并，**没有一处外观跟着变**：

        - 「大号统计数字」统一成 **26**（原 `DataWindow` 26 ×4、`MainWindow` 22 ×3）
        - 「卡片小标题」统一成 **15 半粗**（原 14 半粗 ×9、15 半粗 ×6）

        ⚠️ 要用「整套外观」的地方请用上面/下面那批 `Style`，别用这几支 ——
        这几支不会带字族和颜色。反过来同理：凡元素上已经有 `Style` 的，
        就地改字号等于让定义和用处对不上（见 `BodySecondary` 上面那段）。

        ⚠️ 名字里的角色是**量出来的**，不是拍的：每个值出现的处数写在后面。
        ⚠️ 「卡片小标题」走的是 `TextSizeEmphasis` + 就地 `FontWeight="SemiBold"`，
        **不在下面单独开一支** —— 单开一支就等于把「15」写两遍，下次改一处漏一处。
    -->
    <sys:Double x:Key="TextSizeStat">26</sys:Double>      <!-- 大号统计数字（7 处） -->
    <sys:Double x:Key="TextSizeEmphasis">15</sys:Double>  <!-- 主操作区的大字 + 卡片小标题：扫码框、主按钮内容、选项标题（21 处） -->
    <sys:Double x:Key="TextSizeSubhead">14</sys:Double>   <!-- 大一档的次要文字（6 处） -->
    <sys:Double x:Key="TextSizeBody">13</sys:Double>      <!-- 正文（9 处） -->
    <sys:Double x:Key="TextSizeCaption">12</sys:Double>   <!-- 说明（9 处） -->
    <sys:Double x:Key="TextSizeNote">11</sys:Double>      <!-- 角标 / 脚注（5 处） -->

    <!--
        页面 / 窗口的大标题（28 加粗）。

        ⚠️ 2026-10-09 需求方拍板「大标题统一成 28 加粗」。改之前这一个角色在五个
        地方是**四个字号**：这个定义 20、`RoleWindow` 就地覆盖 28、
        `WizardWindow` 手写 24 Bold、`SettingsWindow` 手写 15 —— 后两处连令牌
        都没挂。就地覆盖和手写是同一个问题的两种写法：下一处想要「大标题」的人
        只能再抄一遍，于是再多一个字号。
    -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        卡片里的标题（20 半粗）。

        ⚠️ 这是 `RoleWindow` 结果卡「请完成上面两个选择」原来的样子 —— 它当时挂的是
        `PageTitle`（20）+ 就地 `FontSize="20"`，那个覆盖是**冗余**的（跟定义同值）。
        现在 `PageTitle` 长到 28，卡片标题不该跟着长，所以要有个自己的名字。
        **它不是大标题**：大标题是窗口/页面那一层，这个在卡里。
    -->
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 说明文字。**原来这些地方是满屏重复的 `Foreground="#88666666"`。** -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--
        空值行：文本为空时**整行收掉**。

        ⚠️ 为什么需要它：`Auto` 高度的行里，一个空的 TextBlock **仍然占一行高**
        —— 「待办」卡上「待清理」「未备份逾期」两行的值多数时候是空的，
        于是卡片上会挂两条什么都没有的空白（2026-09-28 截图里看出来的）。
        收掉值那一格还不够：左边的标签得跟着一起走，所以标签那边
        用 `Visibility="{Binding ElementName=…, Path=Visibility}"` 跟着值走。
    -->
    <Style x:Key="ValueLine" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionLine" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        次要色的正文（13 号）。

        ⚠️ 原来这 6 处是 `Caption` + 就地 `FontSize="13"`。拧 Caption 的字号是
        **拧错了旋钮**：那份定义说的是「12 号的次要文字」，就地改它等于让定义和
        用处对不上 —— 下一处想要同样效果的人只会再抄一遍这行覆盖。
    -->
    <Style x:Key="BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- 标签列。原来是每处手写 `Width="66"`，现在一个样式收口。 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Width" Value="76"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── 卡片 ──────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ── 按钮 ──────────────────────────────────────────────────── -->
    <!--
        重写模板的理由：默认 Button 的 chrome 是系统渐变 + 系统边框，
        自定 Background 之后蓝色底会和它打架（悬停/按下时尤其明显）。

        ⚠️ 悬停/按下**不用写死的色值**，而是在底色上叠一层半透明黑：
        图上 32 张全是静态截图，**没有任何一张量得到悬停态** ——
        与其猜 Tailwind 的 hover 步进，不如用一条对任何底色都成立的规律
        —— 这也是它当年能**一套模板服务两套蓝**的原因；那两套蓝
        2026-10-07 已合并（见文件头），但这条规律本身仍然值钱。
    -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource AccentSolid}"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource AccentDisabled}"/>
                            <!-- ⚠️ 不写死 White：暗色下白字压深底比可用态还清楚（见上面那个键）。 -->
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDisabledInk}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ⚠️ 这里原有一个 `PrimaryButtonStrong`（设置窗专用，只把底色换成
         blue-600）—— 2026-10-07 两套蓝合并后它没有存在意义，已删。
         三个调用点改用 `PrimaryButton`（现在的底色本来就是 blue-600）。 -->

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="{StaticResource RadiusControl}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource HoverOverlaySoft}"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        危险操作（删除录像这类）。与主按钮同构，只换红底。
        ⚠️ 红色本身是从 Tailwind 取的同源色（图上没有红），见上面 `Danger` 的说明。
    -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
    </Style>

    <!--
        绿色主按钮（主窗那颗【开始录制】）。

        ⚠️ **它存在的唯一理由是「禁用时得看得灰」**：此前那颗按钮把底色写成
        `Background="{DynamicResource Success}"` 的**本地值**，而本地值压过
        `PrimaryButton` 里 `IsEnabled=False` 的触发器 —— 于是空单号时它是一颗
        满绿的按钮，点下去毫无反应（2026-10-02 实测报上来的）。
        底色改由**样式**给，触发器就压得住了。
    -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Success}"/>
    </Style>

    <!--
        无边框的图标按钮（输入框里那个 ✕ 这类）。
        默认 Button 的 chrome 是系统渐变 + 系统边框，一个透明底的小 ✕ 套上去
        会变成「灰底方块里一个叉」，与图上的样子差得远。所以这里重写模板，
        只留内容，悬停时叠一层浅灰。
    -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusTag}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 左侧导航项（设置窗） ──────────────────────────────────── -->
    <!--
        用 RadioButton 而不是 Button/ToggleButton：**互斥是白送的**
        （同一个 GroupName 自动单选），不用自己维护「当前选中谁」。

        选中态照图：**白底 + 蓝字**，浮在 `SidebarBackground`（slate-50）的侧栏上。
        ⚠️ 图上量到的是「选中 = 纯白 / 未选中 = slate-50」，**不是**浅蓝底 ——
        这一点与上一版 SaaS 外观相反，别照旧印象改回去。
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" Padding="12,9" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource CardBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 开关（ToggleButton） ──────────────────────────────────── -->
    <!--
        照图：胶囊轨道 + 白色圆点，开 = 蓝底、关 = 灰底。
        用 ToggleButton 而不是 CheckBox：绑定的就是个 bool，不用处理 null。
    -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="{DynamicResource BorderStrong}" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource AccentSolid}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 小标签 ────────────────────────────────────────────────── -->
    <!--
        状态小标签（「已备份」「待上传」「未配置」这类）。用法：
        `<Border Style="{StaticResource TagPill}"><TextBlock Text="已备份"/></Border>`
        —— 底色/字色由调用处设，因为图上有五六种颜色，写死在这里还不如不写。
    -->
    <Style x:Key="TagPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusTag}"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
