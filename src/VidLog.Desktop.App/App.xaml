<Application x:Class="VidLog.Desktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VidLog.Desktop.App"
             ShutdownMode="OnExplicitShutdown">
    <!--
        刻意不设 StartupUri：主窗口要拿到 AppHost 才能构造
        （装配活得比窗口长，见 AppHost 的说明）。引导在 App.OnStartup 里。
        ShutdownMode 用 OnExplicitShutdown：关窗口只是收进托盘，
        规格 §3.2.1 要求后台仍然收码。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 设计语言（颜色 / 文字 / 卡片 / 按钮 / 导航项）。
                     2026-09-28 之前这里是**空的** —— 颜色全是内联字面量手工重复。 -->
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
