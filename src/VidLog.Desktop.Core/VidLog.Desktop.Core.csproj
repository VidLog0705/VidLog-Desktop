<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      摄像头识码（规格 §3.2.1）。**这是本仓唯一的第三方依赖。**

      许可证：Apache-2.0 —— 商用安全，不要求衍生作品开源，无署名义务。
      规格 §10 要求逐个核对许可证，记录见 docs/实现决策.md。

      .NET 5+ 下核心包**不含任何图像库绑定**，可以直接喂裸灰度像素
      （RGBLuminanceSource.BitmapFormat.Gray8），因此不需要
      ImageSharp / SkiaSharp / System.Drawing 那些重的绑定包。
      ffmpeg 的 rawvideo gray 输出正好是紧凑的 w×h 亮度，stride == width。
    -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
