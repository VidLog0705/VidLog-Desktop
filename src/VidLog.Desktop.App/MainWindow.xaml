<Window x:Class="VidLog.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VidLog.Desktop.App"
        mc:Ignorable="d"
        Title="VidLog" Height="640" Width="980"
        Closing="OnClosing">
    <TabControl Margin="10">
        <!-- ── 工作 ─────────────────────────────────────────── -->
        <TabItem Header="工作">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="VidLog · 电脑端" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Text="正在启动…"/>

                    <!-- 工作模式（规格 §3.3.1）。三者的差别全在「什么时候停」。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="工作模式" VerticalAlignment="Center" Width="66"/>
                        <ComboBox x:Name="ModeCombo" Width="190" SelectionChanged="OnModeChanged">
                            <ComboBoxItem Tag="Continuous">连续扫（换件即换段）</ComboBoxItem>
                            <ComboBoxItem Tag="StopOnSameWaybill">同码停（复扫同号停）</ComboBoxItem>
                            <ComboBoxItem Tag="StopOnStaticAfterRescan">扫码静止停录</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="静止停录" VerticalAlignment="Center" Margin="20,0,0,0" Width="66"/>
                        <ComboBox x:Name="StaticCombo" Width="110" SelectionChanged="OnStaticChanged">
                            <ComboBoxItem Tag="Off">关闭</ComboBoxItem>
                            <ComboBoxItem Tag="Two">2 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Three">3 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Four">4 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Five">5 分钟</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="时长兜底" VerticalAlignment="Center" Margin="20,0,0,0" Width="66"/>
                        <ComboBox x:Name="DurationCombo" Width="110" SelectionChanged="OnDurationChanged">
                            <ComboBoxItem Tag="Off">关闭</ComboBoxItem>
                            <ComboBoxItem Tag="Four">4 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Five">5 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Six">6 分钟</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- 踩坑 #13：一个改了没反应的开关，用户只会以为它坏了。
                         静止停录卡在「录制中怎么拿到画面」—— 那条路已被实测否决
                         （见 docs/实现决策.md §24、§25、§28）。如实写出来，
                         比让它悄悄不生效强；但这句是待办，不是终态。 -->
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#88666666"
                               Text="⚠️ 静止停录暂不生效：录像中相机是独占的，另开取帧进程实测取不到画面，所以现在选哪个档位都不会自动停录。"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,14,0,0" Padding="12"
                        BorderThickness="1" CornerRadius="4" BorderBrush="#33000000">
                    <StackPanel>
                        <TextBlock Text="录制" FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="摄像头" VerticalAlignment="Center" Width="66"/>
                            <ComboBox x:Name="CameraCombo" Width="300" IsEnabled="False"/>
                            <TextBlock x:Name="CameraHint" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="#88666666" Text=""/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="单号" VerticalAlignment="Center" Width="66"/>
                            <TextBox x:Name="WaybillBox" Width="300" IsEnabled="False"
                                     TextChanged="OnWaybillChanged"/>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="#88666666"
                                       Text="扫码枪直接扫即可；也可手打后按回车"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="StartWorkButton" Content="开始工作" Padding="18,6"
                                    IsEnabled="False" Click="OnStartWork"/>
                            <Button x:Name="StopWorkButton" Content="结束" Padding="18,6"
                                    Margin="8,0,0,0" IsEnabled="False" Click="OnStopWork"/>
                            <TextBlock x:Name="RecordingStatus" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" x:Name="NoticesText" Margin="0,12,0,0"
                           TextWrapping="Wrap" Foreground="#CC333333"/>
            </Grid>
        </TabItem>

        <!-- ── 检索与回放 ───────────────────────────────────── -->
        <TabItem Header="检索与回放">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="单号" VerticalAlignment="Center" Width="40"/>
                    <TextBox x:Name="SearchBox" Width="220" KeyDown="OnSearchKeyDown"/>

                    <ComboBox x:Name="MatchCombo" Width="110" Margin="8,0,0,0" SelectedIndex="1">
                        <ComboBoxItem Tag="Exact">精确</ComboBoxItem>
                        <ComboBoxItem Tag="Prefix">前缀</ComboBoxItem>
                        <ComboBoxItem Tag="Fuzzy">模糊</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="日期" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <DatePicker x:Name="FromDate" Width="130"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Margin="6,0"/>
                    <DatePicker x:Name="ToDate" Width="130"/>

                    <TextBlock Text="类型" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <ComboBox x:Name="BusinessCombo" Width="100" SelectedIndex="0">
                        <ComboBoxItem Tag="">全部</ComboBoxItem>
                        <ComboBoxItem Tag="Outbound">发货</ComboBoxItem>
                        <ComboBoxItem Tag="Return">退货</ComboBoxItem>
                    </ComboBox>

                    <Button x:Name="SearchButton" Content="检索" Padding="16,4"
                            Margin="14,0,0,0" Click="OnSearch"/>
                    <Button x:Name="OpenPlaybackButton" Content="局域网回放页" Padding="16,4"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnOpenPlayback"/>
                    <Button x:Name="OpenDataFolderButton" Content="数据目录" Padding="16,4"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnOpenDataFolder"/>
                </StackPanel>

                <DataGrid x:Name="ResultsGrid" Grid.Row="1" Margin="0,12,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="OnResultSelected"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="150"/>
                        <DataGridTextColumn Header="单号" Binding="{Binding Waybill}" Width="160"/>
                        <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="80"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Business}" Width="70"/>
                        <DataGridTextColumn Header="会话" Binding="{Binding SessionId}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" x:Name="SearchStatus" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="#CC333333"/>
            </Grid>
        </TabItem>

        <!-- ── 设置 ─────────────────────────────────────────── -->
        <TabItem Header="设置">
            <StackPanel Margin="16">
                <TextBlock Text="连接电脑 / 手机" FontWeight="SemiBold"/>
                <Button x:Name="EnrollButton" Content="连接电脑/手机" Padding="16,6"
                        Margin="0,4,0,0" HorizontalAlignment="Left" Click="OnEnroll"/>
                <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                           Text="点开弹出一张二维码，手机端扫它来申请连接。申请到了由你决定同意还是拒绝 —— 没有这一步，手机换不到凭据，录像传不上来。"/>

                <TextBlock Text="分段时长（分钟）" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <TextBox x:Name="SegmentBox" Width="120" Margin="0,4,0,0"
                         HorizontalAlignment="Left"/>
                <TextBlock Text="单个分段的上限。到点自动滚下一段，用户无感。" Margin="0,2,0,0"
                           Foreground="#88666666" TextWrapping="Wrap"/>

                <TextBlock Text="回放服务端口" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBox x:Name="PortBox" Width="120" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                <TextBlock Text="改了要重启才生效。" Margin="0,2,0,0"
                           Foreground="#88666666"/>

                <TextBlock Text="归档层" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <ComboBox x:Name="ArchiveCombo" Width="200" Margin="0,4,0,0"
                          HorizontalAlignment="Left" SelectionChanged="OnArchiveChanged">
                    <ComboBoxItem Tag="LocalDisk">本机磁盘</ComboBoxItem>
                    <ComboBoxItem Tag="Nas">NAS</ComboBoxItem>
                    <ComboBoxItem Tag="Cloud">网盘</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="录像备份到哪儿去了。只有在别处还有一份时，清掉盘上这份才是安全的。"
                           Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"/>

                <!-- 归档层 = 本机磁盘时这块**不出现**（规格 §3.5.1）——
                     那时盘上这份是唯一副本，给了开关也只能是「改了没反应」。 -->
                <StackPanel x:Name="RetentionPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="已备份后的本地保留期（发货 / 退货各一份）" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="这份设置现在只是记下你的选择 —— 真正开删要等归档层接通（M5/M6）。今天不会有任何文件被删。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="发货" VerticalAlignment="Center" Width="40"/>
                        <ComboBox x:Name="OutboundRetentionCombo" Width="120"
                                  SelectionChanged="OnRetentionChanged"/>
                        <TextBlock Text="退货" VerticalAlignment="Center" Width="40" Margin="20,0,0,0"/>
                        <ComboBox x:Name="ReturnRetentionCombo" Width="120"
                                  SelectionChanged="OnRetentionChanged"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="发货与退货各一份，改一份不动另一份。保留期从「归档成功那一刻」起算，不是从录完起算。"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="⚠️「不保留」不是立刻删：最近 24 小时内录的一律不动（硬性豁免，关不掉），所以它实际是「归档后最快 24 小时清理」。"/>
                </StackPanel>
                <TextBlock x:Name="RetentionAbsentNote" Margin="0,16,0,0"
                           Foreground="#88666666" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="SaveSettingsButton" Content="保存设置" Padding="16,6"
                            Click="OnSaveSettings"/>
                    <TextBlock x:Name="SettingsStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="需要注意" FontWeight="SemiBold" Margin="0,24,0,4"
                           x:Name="WarningsHeader" Visibility="Collapsed"/>
                <ListBox x:Name="WarningsList" MaxHeight="160"
                         HorizontalContentAlignment="Stretch" Visibility="Collapsed"/>

                <Button x:Name="ExportDiagnosticsButton" Content="导出诊断包"
                        Padding="16,6" Margin="0,16,0,0" HorizontalAlignment="Left"
                        Click="OnExportDiagnostics"/>
                <TextBlock Text="把日志、设置与环境信息打成一个 zip，不含任何视频。"
                           Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
