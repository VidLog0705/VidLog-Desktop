<Window x:Class="VidLog.Desktop.App.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VidLog.Desktop.App"
        mc:Ignorable="d"
        Title="电脑录像配置向导" Height="685" Width="900" MinWidth="820" MinHeight="620"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource PageBackground}"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
        ════════════════════════════════════════════════════════════════
        配置向导（2026-09-30，批次 3）

        照需求方设计图 `_16`–`_34`（7 步，去掉重复的 8 张）：
        顶部大标题 + 左侧 7 步编号导航 + 右侧内容卡 + 底部【上一步】/【下一步】。
        版式与色值全部走 Theme.xaml 的 token，这一层不写字面色值。

        ⚠️ Core 侧的能力**早就齐了**（`PreviewProcess` / `MicrophoneLevelMonitor` /
        `Code128` / `FfmpegSpecProbe`），本文件之前**一步界面都没写过** ——
        所以设置页那句「在【配置向导 → 选择摄像头】里改」一直指向一个不存在的东西
        （2026-09-30 的 §5 真机验收把这条记下来了）。

        ⚠️ 第 2 步的预览用 `PreviewProcess`（**相机独占**：它只在没在录制的时候能起，
        见那个类的说明）。向导里不会同时录制，所以安全。

        ⚠️ 第 3 步「预览 + 同时识码」**不是两路输出**：一路彩色帧，C# 侧降频
        转灰度喂 ZXing（§72.1 量过吞吐才这么定的）。
        ════════════════════════════════════════════════════════════════
    -->
    <Window.Resources>

        <!-- 每一步的大标题（比 `SectionTitle` 大一档，照图 ~20px）。 -->
        <Style x:Key="WizardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!--
            左侧 7 步导航。
            ⚠️ 与设置窗的 `NavItem` 刻意不同：那个是「白底浮在 slate-50 侧栏上」，
            而这里**导航本身就在一张白卡里**，所以选中态只能靠**颜色**区分
            （图上量到的正是这样：整个向导左侧没有第二层底色）。
        -->
        <Style x:Key="WizardStep" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="10,7" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            可点的大卡片（步 1 的打包模式、步 3 的识别方式）。
            照图：未选 = 1px 灰描边，选中 = 2px 蓝描边 + 蓝点。
            ⚠️ 选中时把 Padding 各减 1，否则 2px 描边会让内容**跳一下**。
        -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="15,12" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="16" Height="16"
                                      Margin="0,2,12,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource BorderStrong}"
                                             StrokeThickness="2" Fill="Transparent"/>
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="Transparent"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Padding" Value="14,11"/>
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Dot" Property="Fill"
                                        Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            进度条 / 音量条。
            ⚠️ 自己写模板而不是用系统默认：默认那套是 Aero 的绿渐变，
            与图上那条**蓝底浅蓝轨**不是一回事，而 `Foreground` 在默认模板里
            并不总是说了算（各主题不一样）。十几行换个说到做到。
        -->
        <Style x:Key="WizardProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentWeak}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSolid}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator" RadiusX="3" RadiusY="3"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 音量条：同一个模板，绿底（照图 `_32`）。 -->
        <Style x:Key="LevelBar" TargetType="ProgressBar" BasedOn="{StaticResource WizardProgress}">
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>

        <!-- 预览区：深底 + 中间一句说明。 -->
        <Style x:Key="PreviewSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource VideoBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!--
            预览区上浮着的那句提示（图上是一块半透明深色小方块）。
            ⚠️ 键名是 `OverlayPill`，**不是 `PreviewHint`** —— 后者是里面那个
            TextBlock 的 `x:Name`，两者同名的话读起来永远要猜这句指的是哪个。
        -->
        <Style x:Key="OverlayPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OverlayPillBackground}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="33,30,33,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 顶部标题 ═══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="电脑录像配置向导" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Margin="0,6,0,0" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="按步骤配置摄像头、面单识别方式、麦克风和可选扫码枪"/>
        </StackPanel>

        <!-- ══ 主体：左导航 + 右内容 ═══════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}" Padding="8,12">
                <StackPanel>
                    <!-- ⚠️ `Checked` 在 InitializeComponent 里就会为默认项响一次，
                         所以处理函数必须容忍「控件还没建齐」。 -->
                    <RadioButton x:Name="Nav0" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="0" IsChecked="True"
                                 Content="1. 选择打包模式" Checked="OnStepChecked"/>
                    <RadioButton x:Name="Nav1" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="1"
                                 Content="2. 选择摄像头" Checked="OnStepChecked"/>
                    <RadioButton x:Name="Nav2" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="2"
                                 Content="3. 摄像头识别" Checked="OnStepChecked"/>
                    <RadioButton x:Name="Nav3" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="3"
                                 Content="4. 录制性能检测" Checked="OnStepChecked"/>
                    <RadioButton x:Name="Nav4" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="4"
                                 Content="5. 选择麦克风" Checked="OnStepChecked"/>
                    <RadioButton x:Name="Nav5" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="5"
                                 Content="6. 扫码枪（可选）" Checked="OnStepChecked"/>
                    <RadioButton x:Name="Nav6" Style="{StaticResource WizardStep}"
                                 GroupName="WizardNav" Tag="6"
                                 Content="7. 完成" Checked="OnStepChecked"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="26,0,0,0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22">
                    <Grid>

                        <!-- ══════════════════════════════════════════════
                             步 1 · 选择打包模式
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step0Panel">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="选择打包模式"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,16"
                                       TextWrapping="Wrap"
                                       Text="推荐连续打包模式，识别或扫描下一张面单时自动保存上一单"/>

                            <RadioButton x:Name="ModeContinuous" Style="{StaticResource ChoiceCard}"
                                         GroupName="ModeChoice">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="连续打包模式" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <Border Style="{StaticResource TagPill}" Margin="8,0,0,0"
                                                Background="{DynamicResource AccentSolid}">
                                            <TextBlock Text="推荐" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="识别或扫描下一张面单条码后，自动结束上一单并开始下一单"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeSameWaybill" Style="{StaticResource ChoiceCard}"
                                         GroupName="ModeChoice">
                                <StackPanel>
                                    <TextBlock Text="同码停录模式" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="识别或扫描面单条码开始录制，再次识别同一条码停止录制"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════
                             步 2 · 选择摄像头
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step1Panel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="选择摄像头"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="选择录像使用的摄像头，并确认实时画面显示正常"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CameraCombo" Grid.Column="0" Height="32"
                                          SelectionChanged="OnCameraChanged"/>
                                <Button x:Name="TestConnectionButton" Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Padding="14,6" Height="32"
                                        Content="测试连接" Visibility="Collapsed"
                                        Click="OnTestConnection"/>
                            </Grid>

                            <TextBox x:Name="NetworkUrlBox" Margin="0,8,0,0" Height="30"
                                     VerticalContentAlignment="Center" Visibility="Collapsed"
                                     TextChanged="OnNetworkUrlChanged"
                                     ToolTip="rtsp://账号:密码@192.168.1.64:554/stream"/>
                            <TextBlock x:Name="NetworkUrlHint" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="例如：rtsp://账号:密码@192.168.1.64:554/stream"/>

                            <Border Style="{StaticResource PreviewSurface}" Height="190"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <!-- ⚠️ `Uniform` 而不是 `Fill`：`Fill` 会把画面**拉变形**
                                         去填满这个框（预览区比 16:9 扁得多，实测拉成了 3:1），
                                         而用户在这一步正是靠这幅画面判断摄像头装正没有 ——
                                         一幅变形的人像判不出朝向。
                                         `PreviewProcess` 那边已经把源补成 16:9 并补黑边了，
                                         所以这里等比缩放之后剩下的黑边与视频底同色，看不出接缝。 -->
                                    <Image x:Name="PreviewImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border x:Name="PreviewHintBox" Style="{StaticResource OverlayPill}">
                                        <TextBlock x:Name="PreviewHint" FontSize="12"
                                                   Foreground="White" TextWrapping="Wrap"
                                                   Text="未检测到可用摄像头"/>
                                    </Border>
                                    <!-- 方向：一档一档转（图上那颗胶囊按钮）。
                                         ⚠️ 文案由 `RecordingSpec.RotationLabel` 一处产出，
                                         不在 XAML 里写死 —— 全仓只有那一处认四档。 -->
                                    <Button x:Name="RotationButton"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,12,12" Padding="12,5"
                                            Click="OnCycleRotation"
                                            Content="旋转 180°"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════
                             步 3 · 摄像头识别
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="是否使用摄像头识别面单"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="开启后可直接将面单条形码放入画面，识别成功后自动开始或切换录像"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RecognitionOn" Grid.Column="0"
                                             Style="{StaticResource ChoiceCard}"
                                             GroupName="RecognitionChoice" Margin="0,0,5,10"
                                             Checked="OnRecognitionChanged">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="使用摄像头识别" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <Border Style="{StaticResource TagPill}" Margin="8,0,0,0"
                                                    Background="{DynamicResource AccentSolid}">
                                                <TextBlock Text="推荐" FontSize="11" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="实时测试画面中的面单条码"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RecognitionOff" Grid.Column="1"
                                             Style="{StaticResource ChoiceCard}"
                                             GroupName="RecognitionChoice" Margin="5,0,0,10"
                                             Checked="OnRecognitionChanged">
                                    <StackPanel>
                                        <TextBlock Text="不使用摄像头识别" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="改用扫码枪或手动输入面单号"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <!-- 开着：预览 + 虚线取景框 + 识别结果 -->
                            <Border x:Name="RecognitionPreviewBox"
                                    Style="{StaticResource PreviewSurface}" Height="190">
                                <Grid>
                                    <Image x:Name="RecognitionImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- 取景框：图上那条蓝色虚线框（只是给人看的引导，
                                         识码本身仍读整帧 —— 裁一块再喂 ZXing 只会
                                         把「码略微出框」变成识别不了）。 -->
                                    <!-- 取景框顶边让开上面那颗提示药丸（它高约 26px）。 -->
                                    <Border Margin="90,46,90,16" BorderThickness="2"
                                            BorderBrush="{DynamicResource Accent}"
                                            CornerRadius="{StaticResource RadiusTag}" IsHitTestVisible="False"/>
                                    <Border Style="{StaticResource OverlayPill}"
                                            VerticalAlignment="Top" Margin="0,10,0,0">
                                        <TextBlock Text="将面单条形码放入框内" FontSize="12"
                                                   Foreground="White"/>
                                    </Border>
                                    <!-- 取不到画面时的说明。⚠️ 与步 2 那句**同源**
                                         （`SetOverlayHint` 一次写两处）：这一档没画面时
                                         若只是黑框加一个虚线框，用户会以为「识别坏了」，
                                         而真实原因往往是「还没点测试连接」。 -->
                                    <Border x:Name="RecognitionHintBox"
                                            Style="{StaticResource OverlayPill}">
                                        <TextBlock x:Name="RecognitionHint" FontSize="12"
                                                   Foreground="White" TextWrapping="Wrap"
                                                   Text="未检测到可用摄像头"/>
                                    </Border>
                                    <!-- 设备名。压在预览区深底上，用的是 slate-300；
                                         与 `BorderStrong` 同值（Tailwind 里本就是同一个色），
                                         借它而不是为这一处单开一个键。 -->
                                    <TextBlock x:Name="RecognitionDeviceLabel"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                               Margin="10,0,0,8" FontSize="11"
                                               Foreground="{DynamicResource BorderStrong}"/>
                                    <Border x:Name="RecognitionResultBox"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,10,8" Padding="8,4" CornerRadius="{StaticResource RadiusTag}"
                                            Background="{DynamicResource Success}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="RecognitionResultText" FontSize="11"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 关掉：一句话说明，不画假预览 -->
                            <Border x:Name="RecognitionOffBox" Height="190" Visibility="Collapsed"
                                    Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="已选择不使用摄像头识别" FontSize="14"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               Text="仍可使用扫码枪或在主页面手动输入面单号"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════
                             步 4 · 检测录制性能
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="检测录制性能"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="正在根据这台电脑的编码能力，为已选摄像头推荐稳定的原生分辨率和帧率"/>

                            <!-- 跑着 -->
                            <Border x:Name="PerfRunningBox" Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="18,16">
                                <StackPanel>
                                    <TextBlock x:Name="PerfRunningText" FontSize="13"
                                               Foreground="{DynamicResource Accent}"
                                               TextWrapping="Wrap" Text="正在检测…"/>
                                    <ProgressBar x:Name="PerfBar" Style="{StaticResource WizardProgress}"
                                                 Margin="0,12,0,0" IsIndeterminate="True"/>
                                </StackPanel>
                            </Border>

                            <!-- 结果（成功 / 未完成两种情形共用一张卡） -->
                            <StackPanel x:Name="PerfResultBox" Visibility="Collapsed">
                                <TextBlock x:Name="PerfBanner" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <Border Background="{DynamicResource SurfaceMuted}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusCard}" Padding="18,16" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="PerfResultTitle" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="PerfResultSpec" Style="{StaticResource Body}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock x:Name="PerfResultDetail"
                                                   Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PerfResultNote"
                                                   Style="{StaticResource Caption}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <Button x:Name="PerfRetryButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,14,0,0" Padding="14,6"
                                                HorizontalAlignment="Left" Content="重新检测"
                                                Click="OnRetryPerformance"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════
                             步 5 · 选择麦克风
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="选择麦克风"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="说话时音量条有跳动，就说明麦克风基础配置正常"/>

                            <ComboBox x:Name="MicrophoneCombo" Height="32"
                                      SelectionChanged="OnMicrophoneChanged"/>

                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="14,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <ProgressBar x:Name="MicLevelBar"
                                                 Style="{StaticResource LevelBar}" Height="8"/>
                                    <TextBlock x:Name="MicLevelText" Margin="0,10,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="还没有听到声音 —— 对着麦克风说句话试试"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="⚠️ 麦克风被拒、被别的程序占用、或者中途被拔掉，录像照常进行 —— 只有那一段没有音轨，界面上会写明原因。声音绝不会让整段录像失败。"/>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════
                             步 6 · 扫码枪（可选）
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="扫码枪（可选）"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="没有扫码枪也可手动输入面单号；如需使用，可在这里测试扫码枪"/>

                            <Border Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="18,16">
                                <StackPanel>
                                    <!-- ⚠️ 最近邻缩放：插值会把条与空之间的边界糊成灰边，
                                         表现是「看着像条码、扫不出来」（与 `EnrollWindow`
                                         那张二维码同一条理由）。 -->
                                    <Image x:Name="BarcodeImage" Height="72"
                                           HorizontalAlignment="Center" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock x:Name="BarcodeCaption"
                                               Style="{StaticResource Caption}"
                                               Margin="0,12,0,0" TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- ⚠️ 就是一个**普通输入框**：扫码枪不被拦截
                                 （`KeyboardScanBridge` 明写「不做任何按键抑制」），
                                 所以它打进来的字照常落进焦点所在的那个框里。
                                 不订阅全局钩子 —— 那条路会顺带触发一次「开录」
                                 （`AppHost.Wire` 里 `Scanned` 的另一个订阅者）。 -->
                            <TextBox x:Name="BarcodeInput" Margin="0,12,0,0" Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnBarcodeTyped"/>
                            <TextBlock x:Name="BarcodeHint" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="没有扫码枪可直接进入下一步"/>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════
                             步 7 · 完成
                             ══════════════════════════════════════════════ -->
                        <StackPanel x:Name="Step6Panel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource WizardTitle}" Text="配置完成"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                                       Text="下面是日常打包流程"/>

                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"
                                               Text="1. 使用扫码枪或在主页面输入面单号开始录制"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"
                                               Text="2. 完成当前包裹的打包"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"
                                               Text="3. 扫描或输入下一张面单号"/>
                                    <TextBlock Style="{StaticResource Body}"
                                               Text="4. 软件自动保存上一单并开始下一单"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="18,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="局域网查看视频" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="完成向导后会显示手机连接二维码。手机与这台电脑连接同一个局域网，扫码即可打开打包视频和回放页面"/>
                                    <!-- ⚠️ 图上这一段写着「完成向导后会显示手机连接二维码」，
                                         而那张码在 `EnrollWindow` 里（主窗口底部的
                                         「连接电脑 / 手机」）。这里**不另画一个入口** ——
                                         图上没有那颗按钮，而两个入口出同一张码迟早走岔。 -->
                                </StackPanel>
                            </Border>

                            <!--
                                ⚠️ **这句图上没有，是必须加的**（I3「不许静默失效」）。
                                向导是**改设置**的，而设置各有各的生效时机：摄像头与
                                「摄像头识别」开关是在 `AppHost.StartAsync` 里建的
                                （采集源、`PrerecordController` 都在那儿定死），
                                其余各项写完就生效。不说的话，用户走完向导换了摄像头、
                                点【完成】、发现画面还是旧的 —— 而界面上一个字都没提过。
                            -->
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Warning}"
                                       Text="⚠️ 摄像头那一项（换成另一台设备、或改成网络摄像头地址）和「摄像头识别」开关，要重启软件才生效；其余各项立即生效。"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ 底部按钮 ═══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}"
                    Width="96" Padding="0,8" Content="上一步" IsEnabled="False"
                    Click="OnBack"/>
            <!-- 回车 = 下一步（最后一步是「完成」，同一颗按钮）。
                 ⚠️ **刻意没有 `IsCancel`**：向导中途被 Esc 关掉会把这一遍填的全丢掉，
                 而「回到哪一步」在这个控件里没有对应状态。要退出只能点窗口的 ✕。 -->
            <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}"
                    Width="96" Padding="0,8" Margin="8,0,0,0" Content="下一步"
                    Click="OnNext" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
