<Window x:Class="VidLog.Desktop.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VidLog.Desktop.App"
        mc:Ignorable="d"
        Title="历史录像检索与回放" Height="720" Width="1080" MinWidth="900" MinHeight="600"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource PageBackground}"
        WindowStartupLocation="CenterOwner">
    <!--
        ════════════════════════════════════════════════════════════════
        检索与回放窗口（2026-09-28 从 MainWindow 拆出来）

        ⚠️ 布局照需求方的设计图：**左筛选栏 + 右播放区 + 底部播放条**。
        左边那一栏自上而下是「日期范围 / 单号 / 结果列表 / 共 N 条 / 翻页」。

        ⚠️ 图上没有、但**本仓必须有**的三样（不摆出来就是功能丢失）：
          · **匹配方式**（精确 / 前缀 / 模糊）—— 规格 §3.8 要求三种。
          · **类型**（发货 / 退货）—— 规格 §3.2 的两条业务线。
          · **每行的争议锁定按钮** —— 规格 §3.6.5 的硬豁免，这是电脑端
            用户保住一条纠纷录像的**唯一入口**，丢了它就等于那条录像
            保留期一到必被清掉。
        它们都塞进了左边那一栏，因为图上那一栏本来就是筛选区。

        ⚠️ 图上**有**、2026-09-30 补上的：单号框里那个 ✕（清空）、
        单号框正下方并排的【导出单号】与【导入录像】。
        · 【导出单号】导的是**当前检索出来的这一批**，不是整个库。
          ⚠️ 检索到 0 条时它是禁用的（导一张空表没有意义），悬停写明原因。
        · 【导入录像】走 `ImportWindow`（挑文件、核单号、定录制时间）。

        ⚠️ 图上也**没有**「日历」那颗钮与它那个弹出层（T14 借自 NVR）：
        日期范围那两格只能回答「我写下的那天有没有」，日历回答的是
        「**哪几天**有东西」—— 而用户往往是先不知道自己该写哪天。
        它是**打点**模式下的那一半能用（点一天 = 查那天），不是 NVR 的时间轴。

        ⚠️ **没有任何许可门控**（`04-许可设计.md` L8）：未激活照样检索、
        照样回放、照样导出。拆窗时最容易顺手加一句「未激活先激活」，别加。

        ⚠️ 底下那两个 `Click="OnToggleLock"` / `Tag="{Binding EvidenceId}"`
        被守卫测试**按文本**盯着（`DesktopServicesTests`）—— 拆窗时它们
        从 `MainWindow.xaml` 挪到了这里，测试跟着改读本文件，**断言原文一字不改**。
        ════════════════════════════════════════════════════════════════
    -->

    <Window.Resources>
        <!--
            ⚠️ 这个转换器**只回答 true / false，不返回画刷**（2026-10-07 改）。
            原来它返回 `AccentWeak` 那支笔刷、每次换算时现查 —— 现查解决了「亮色焊死」，
            但**转换器的结果不会被主题切换重新算一遍**：日历开着不动时改系统主题，
            这一天还得再滚一次 / 再搜一次才跟上。色现在由下面那条 `DataTrigger` 给、
            走 `{DynamicResource}`，字典一换 WPF 自己重解析，与别的控件同一条路。
            ⚠️ 顺序不能反：下面那个日的模板用 `{StaticResource DayMark}` 取它，
            StaticResource 只认**写在前面**的。表由后台填（见 `SearchWindow.xaml.cs`）。
        -->
        <local:DayMarkConverter x:Key="DayMark"/>

        <!--
            开日历的那一颗。⚠️ 必须是 `ToggleButton` 而不是普通按钮：
            `StaysOpen=False` 的弹出层**在鼠标按下时**就收掉了，而按钮的 `Click`
            在**抬起时**才来 —— 普通按钮于是永远关不掉自己开的东西（永远「!IsOpen」= 重新打开）。
            `HelpTip` 当初选 ToggleButton 就是这个原因。
        -->
        <Style x:Key="CalendarToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusTag}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SurfaceAlt}"/>
                            </Trigger>
                            <!-- 开着的时候是浅蓝：让用户知道这一屏日历是他点出来的、再点一下收 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentWeak}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            T14：日历上的「日」这一个格子。
            ⚠️ **只换格子**：表头（◀ 月份 ▶）与星期行仍是系统默认样式 ——
            连 `CalendarItem` / `CalendarButton` 一起重写是另外一百多行的事，
            先记着（见提交说明的「已知上限」）。

            ⚠️ 涂色走 `Background="{Binding Converter=…}"`：`CalendarDayButton` 的
            DataContext 就是那一天，所以在模板里问一句「这天算不算」就够了。
            **不用 DataTrigger** —— `Value="True"` 与 bool 的比较是另一处坑，没必要踩。
        -->
        <Style x:Key="MarkedDayButton" TargetType="CalendarDayButton">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="Bd" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ⚠️ 这一条**必须排在**下面悬停 / 选中那两条**前面**：
                                 同一个 TriggerCollection 里，后面的会盖掉前面的。 -->
                            <DataTrigger Binding="{Binding Converter={StaticResource DayMark}}"
                                         Value="True">
                                <Setter TargetName="Bd" Property="Border.Background"
                                        Value="{DynamicResource AccentWeak}"/>
                            </DataTrigger>
                            <!-- ⚠️ 悬停**不能**也用 AccentWeak —— 那是「有录像」的色，
                                 鼠标一划过就分不清这天到底有没有东西了。用中性灰。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Border.Background"
                                        Value="{DynamicResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Border.Background"
                                        Value="{DynamicResource AccentSolid}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 左：筛选 + 结果 ═══════════════════════════════════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,16"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource Body}" Text="录像日期范围："
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- ⚠️ 132 → 118 是给右边那颗日历钮让的位（左栏可用宽 298）。 -->
                            <DatePicker x:Name="FromDate" Width="118"/>
                            <TextBlock Text="至" VerticalAlignment="Center" Margin="6,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <DatePicker x:Name="ToDate" Width="118"/>

                            <!-- T14：这一颗开日历。⚠️ 摆在日期这一行里而不是单起一行 ——
                                 左栏的高度是**结果列表**在用的，多一行就从列表里扣一行。 -->
                            <!-- ⚠️ 刻意**不给 ToolTip**：悬停提示与弹出层都落在按钮正下方，
                                 提示会把日历的月份表头盖掉（2026-10-05 实测）。
                                 要说的话，弹出层底下那一行已经说全了。 -->
                            <ToggleButton x:Name="CalendarButton" Style="{StaticResource CalendarToggle}"
                                          Margin="6,0,0,0"
                                          Checked="OnCalendarToggled" Unchecked="OnCalendarToggled">
                                <Path Data="M 1,3 L 13,3 L 13,13 L 1,13 Z M 1,6 L 13,6 M 4,1 L 4,4.5 M 10,1 L 10,4.5"
                                      Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"/>
                            </ToggleButton>
                        </StackPanel>

                        <!--
                            T14：日历。⚠️ 塞在弹出层里而不是铺在左栏上 ——
                            铺一个两百来像素高的日历，会把结果列表挤成两三行。
                        -->
                        <Popup x:Name="CalendarPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=CalendarButton}"
                               VerticalOffset="4"
                               Opened="OnCalendarOpened" Closed="OnCalendarClosed">
                            <Border Padding="8" CornerRadius="{StaticResource RadiusControl}"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                      Opacity="0.16" Color="{DynamicResource ShadowColor}"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Calendar x:Name="DayCalendar"
                                              CalendarDayButtonStyle="{StaticResource MarkedDayButton}"
                                              SelectedDatesChanged="OnDayPicked"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="6,4,6,2"
                                               Text="浅蓝的日子有录像。点一天，就列出那天的。"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock Style="{StaticResource Body}" Text="单号精准搜索："
                                   Margin="0,14,0,6"/>
                        <!-- 单号框里的那个 ✕（图上有一个）：框右端收窄一点给它腾位置 -->
                        <Grid>
                            <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown"
                                     Padding="6,4,28,4"/>
                            <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,5,0" Click="OnClearSearch"
                                    ToolTip="清空单号搜索框">
                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                      Stroke="{DynamicResource TextDisabled}" StrokeThickness="1.4"/>
                            </Button>
                        </Grid>

                        <!--
                            照图 `_41`：单号框正下方并排两颗按钮。

                            ⚠️ 左【导出单号】= 把**当前检索出来的这一批**写成 CSV；
                            右【导入录像】= 把外面录来的一个视频文件收进库里。
                            两者**不是一对**：导出的东西不是录像（I7，不进索引），
                            而导入进来的就是录像，与本机录的走同一套检索与清理。
                        -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ExportWaybillsButton" Grid.Column="0"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,6" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="OnExportWaybills"
                                    ToolTip="先检索出结果，再导出单号。">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <!-- 清单一枚：内联矢量，不引任何图片资源 -->
                                    <Path Data="M 1,1 L 13,1 L 13,13 L 1,13 Z M 4,4.5 L 10,4.5 M 4,7 L 10,7 M 4,9.5 L 8,9.5"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="导出单号" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportRecordingButton" Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,6" Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch" Click="OnImport"
                                    ToolTip="把外面录来的视频文件收进本机录像库。">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <!-- 文件夹一枚 -->
                                    <Path Data="M 1,12.5 L 1,3.5 L 5.5,3.5 L 7.5,5.5 L 13,5.5 L 13,12.5 Z"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="导入录像" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ComboBox x:Name="MatchCombo" Width="96" SelectedIndex="0">
                                <ComboBoxItem Tag="Exact">精确</ComboBoxItem>
                                <ComboBoxItem Tag="Prefix">前缀</ComboBoxItem>
                                <ComboBoxItem Tag="Fuzzy">模糊</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="BusinessCombo" Width="96" Margin="8,0,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Tag="">全部类型</ComboBoxItem>
                                <ComboBoxItem Tag="Outbound">发货</ComboBoxItem>
                                <ComboBoxItem Tag="Return">退货</ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="SearchButton" Content="检索"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,5" Margin="8,0,0,0" IsEnabled="False"
                                    Click="OnSearch"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="单号框里按回车也能检索。日期结束那天是整日包含的。"/>
                    </StackPanel>

                    <!-- 结果列表。⚠️ 左边栏窄，所以是「一行一条」的列表而不是表格。 -->
                    <Border Grid.Row="1" Margin="0,12,0,0"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                      <Grid>
                        <!--
                            T10 的空态。⚠️ 一片空白等于「不知道是没查到、还没查、还是坏了」——
                            这三件事用户要做的事**不一样**（换条件 / 动手查 / 报缺陷），
                            所以各有各的一句话，由 `RenderPage` 挑。
                        -->
                        <TextBlock x:Name="ResultsPlaceholder" Margin="18"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabled}"
                                   Text="还没有检索。&#x0a;左边挑个日期、或者打上单号，再点【检索】。"/>
                        <ListBox x:Name="ResultsList" BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnResultSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- ⚠️ **两行**：单号与【锁定】并排（第 0 行），
                                         下面那两行说明**跨满整行**（第 1 行）。
                                         原来它们是同一个 StackPanel 挤在「单号那一列」里，
                                         于是**整块**都被右边那颗按钮压掉约 50px ——
                                         下面那句「… · 类型未知」正好差这一点点宽度，
                                         在左边那一栏里被折成两行（2026-10-02 实测：
                                         「类型未 / 知」）。跨满整行就不用再抠那几十像素。 -->
                                    <Grid Margin="2,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Waybill}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>

                                        <!-- 争议锁定（规格 §3.6.5）。⚠️ 它是**硬豁免**（§3.5.3②）：
                                             锁上之后保留期到了也不会自动清理这一条。 -->
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Content="{Binding LockLabel}"
                                                Padding="8,2" Margin="6,0,0,0"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnToggleLock"
                                                Tag="{Binding EvidenceId}"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0"/>
                                            <!-- 重复单号 / 成品不在盘上这类，说明白 -->
                                            <TextBlock Text="{Binding Note}"
                                                       Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Warning}"
                                                       Visibility="{Binding NoteVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="ExportButton" Content="导出原视频（不转码）"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" IsEnabled="False"
                                Click="OnExportResult"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="选中一条之后可以导出 —— 原样另存，不转码、不压缩、不裁剪、不打码。"/>

                        <!-- ⚠️ 与设置窗底部同一条：**两列**，别把文字与按钮摞在一格。
                             摞在一格时两者互不知情，条目一多（「共 1234 条，第 12 / 25 页」）
                             文字就伸到按钮底下被盖住。 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CountText" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="共 0 条"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PrevPageButton" Content="上一页"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,4" IsEnabled="False" Click="OnPrevPage"/>
                                <Button x:Name="NextPageButton" Content="下一页"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,4" Margin="6,0,0,0" IsEnabled="False"
                                        Click="OnNextPage"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 右：播放区 ═══════════════════════════════════════════ -->
            <Border Grid.Column="1" Style="{StaticResource Card}"
                    Margin="0,0,0,16" Padding="0"
                    Background="{DynamicResource VideoBackground}">
                <Grid>
                    <!-- ⚠️ MediaElement 是 WPF 自带的，**不引任何第三方播放器**（I10：离线可用）。
                         能不能解出画面取决于系统解码器 —— 播不了时下面那行会说为什么。 -->
                    <MediaElement x:Name="Player" Stretch="Uniform"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                  MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed"/>

                    <!-- 没选录像时的提示（照图：一个播放图标 + 一行字） -->
                    <StackPanel x:Name="PlayerPlaceholder"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 L 26,15 L 0,30 Z" Fill="{DynamicResource TextDisabled}"
                              HorizontalAlignment="Center"/>
                        <!-- ⚠️ `TextWrapping` + `MaxWidth` **两个都要**：这一行不只写
                             「请选择录像开始播放」，播不了时它换成的是**一整段**话
                             （缺解码器那一段连着四五句）。居中又不换行的长文本会
                             **两头一起被裁掉** —— 2026-10-02 实测：只剩中间一句，
                             「文件在盘上」与末尾的原因都看不见了。
                             播放区宽约 740，620 是给它左右各留一点边。 -->
                        <TextBlock x:Name="PlayerHintText" Text="请选择录像开始播放"
                                   Margin="0,14,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="620" TextAlignment="Center"
                                   Foreground="{DynamicResource TextDisabled}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ 底部播放条 ══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource VideoBackground}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayButton" Grid.Column="0" Content="播放"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="88" IsEnabled="False" Click="OnPlayPause"/>

                <Slider x:Name="PositionSlider" Grid.Column="1" Margin="16,0"
                        VerticalAlignment="Center"
                        Minimum="0" Maximum="1" Value="0"
                        IsEnabled="False"
                        Thumb.DragStarted="OnSeekStarted"
                        Thumb.DragCompleted="OnSeekCompleted"/>

                <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="White" Text="00:00:00 / 00:00:00"/>
            </Grid>
        </Border>
    </Grid>
</Window>
