<Window x:Class="VidLog.Desktop.App.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="导入录像" Height="620" Width="560" MinWidth="520" MinHeight="560"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterOwner">
    <!--
        ════════════════════════════════════════════════════════════════
        导入录像（设计图 `_41` 左栏那颗按钮，2026-09-30 补）

        它问三件事，而这三件事**都不能猜**：
          · 挂到哪个单号上（索引里单号是唯一的事实标识）；
          · 发货还是退货；
          · 这一段是什么时候录的（决定它按哪个日期被检索到、什么时候被清理，
            而它本身就是证据元数据里的 StartedAt）。

        另外三件事是**量出来的、不是问出来的**：时长、编码、尺寸 ——
        由 `RecordingImporter` 从文件里读（读不出来就空着，不编）。

        ⚠️ 兜底提示里那句「量不出时长就按 0 记」必须留着：索引里那个字段
        没有「不知道」这个取值，不说的话用户会以为这段录像真的只有 0 秒。
        ════════════════════════════════════════════════════════════════
    -->
    <Grid Margin="16">
        <Border Style="{StaticResource Card}" Padding="18" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 文件 ──────────────────────────────────────────── -->
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource Body}" Text="要导入的文件：" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SourceBox" Grid.Column="0" IsReadOnly="True"
                                 Background="{StaticResource SurfaceMuted}"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,5" Margin="8,0,0,0" Click="OnBrowse"/>
                    </Grid>
                </StackPanel>

                <!-- ── 单号 ──────────────────────────────────────────── -->
                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource Body}" Text="挂到哪个单号上："
                               Margin="0,16,0,6"/>
                    <TextBox x:Name="WaybillBox"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="默认取文件名（本机导出的成品就是「单号.mp4」）。请核对 —— 填错了，这条录像在按单号检索时找不到。"/>
                </StackPanel>

                <!-- ── 业务类型 ──────────────────────────────────────── -->
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource Body}" Text="业务类型：" Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="OutboundRadio" Content="发货" GroupName="ImportBusiness"
                                     IsChecked="True"
                                     Foreground="{StaticResource TextPrimary}"/>
                        <RadioButton x:Name="ReturnRadio" Content="退货" GroupName="ImportBusiness"
                                     Margin="24,0,0,0"
                                     Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── 录制时间 ──────────────────────────────────────── -->
                <StackPanel Grid.Row="3">
                    <TextBlock Style="{StaticResource Body}" Text="录制时间：" Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="StartedDate" Width="150"/>
                        <TextBox x:Name="StartedTime" Width="92" Margin="8,0,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Text="（时:分:秒）"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="默认取文件的最后修改时间 —— 那是个猜测，请核对。它决定这条录像按哪个日期被检索到、以及什么时候会被清理。"/>
                </StackPanel>

                <!-- ── 说明 + 状态 ───────────────────────────────────── -->
                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="文件会被复制进录像目录（原文件留在原地不动），然后量时长、算哈希、写进索引。做完之后它和本机录的没有区别：能检索、能回放、能导出，也照常参与保留期清理。"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                               Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ── 按钮 ──────────────────────────────────────────── -->
                <StackPanel Grid.Row="5" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <!-- ⚠️ `IsDefault` 加在这颗上：它**初始是禁用的**，而 WPF 在
                         IsDefault 按钮禁用时不会吞掉回车 —— 选文件那一步的回车
                         照旧归系统文件对话框。 -->
                    <Button x:Name="CancelButton" Content="取消" MinWidth="88"
                            Style="{StaticResource SecondaryButton}" Click="OnCancel"
                            IsCancel="True"/>
                    <Button x:Name="ImportButton" Content="导入" MinWidth="88" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Click="OnImport" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
