<Window x:Class="VidLog.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VidLog.Desktop.App"
        mc:Ignorable="d"
        Title="VidLog" Height="640" Width="980"
        Closing="OnClosing">
    <TabControl Margin="10">
        <!-- ── 工作 ─────────────────────────────────────────── -->
        <TabItem Header="工作">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="VidLog · 电脑端" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Text="正在启动…"/>

                    <!-- 工作模式（规格 §3.3.1）。**电脑端只有两种** —— 「扫码静止停录」
                         已按需求方 2026-09-24 的裁定删掉（那一端拿不到画面，见 §28.5）。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="工作模式" VerticalAlignment="Center" Width="66"/>
                        <ComboBox x:Name="ModeCombo" Width="190" SelectionChanged="OnModeChanged">
                            <ComboBoxItem Tag="Continuous">连续扫（换件即换段）</ComboBoxItem>
                            <ComboBoxItem Tag="StopOnSameWaybill">同码停（复扫同号停）</ComboBoxItem>
                        </ComboBox>

                        <!-- 闲置提醒（规格 §3.3.3 电脑端那半）：连续 N 分钟没有任何扫码或打点
                             → 播报提醒，**绝不改录制状态**。它看的不是画面。 -->
                        <TextBlock Text="闲置提醒" VerticalAlignment="Center" Margin="20,0,0,0" Width="66"/>
                        <ComboBox x:Name="IdleCombo" Width="110" SelectionChanged="OnIdleReminderChanged">
                            <ComboBoxItem Tag="Off">关闭</ComboBoxItem>
                            <ComboBoxItem Tag="Two">2 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Three">3 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Four">4 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Five">5 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Custom">自定义</ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="IdleMinutesBox" Width="46" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center"
                                 LostFocus="OnIdleMinutesChanged"/>
                        <TextBlock Text="分钟" VerticalAlignment="Center" Margin="4,0,0,0"/>

                        <TextBlock Text="时长兜底" VerticalAlignment="Center" Margin="20,0,0,0" Width="66"/>
                        <ComboBox x:Name="DurationCombo" Width="110" SelectionChanged="OnDurationChanged">
                            <ComboBoxItem Tag="Off">关闭</ComboBoxItem>
                            <ComboBoxItem Tag="Four">4 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Five">5 分钟</ComboBoxItem>
                            <ComboBoxItem Tag="Six">6 分钟</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#88666666"
                               Text="闲置提醒只看「有没有扫码或打点」，不看画面；到点只出声提醒，不会替你停录 —— 真正会停的是右边的时长兜底。"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,14,0,0" Padding="12"
                        BorderThickness="1" CornerRadius="4" BorderBrush="#33000000">
                    <StackPanel>
                        <TextBlock Text="录制" FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="摄像头" VerticalAlignment="Center" Width="66"/>
                            <ComboBox x:Name="CameraCombo" Width="300" IsEnabled="False"/>
                            <TextBlock x:Name="CameraHint" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="#88666666" Text=""/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="单号" VerticalAlignment="Center" Width="66"/>
                            <TextBox x:Name="WaybillBox" Width="300" IsEnabled="False"
                                     TextChanged="OnWaybillChanged"/>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="#88666666"
                                       Text="扫码枪直接扫即可；也可手打后按回车"/>
                        </StackPanel>

                        <!-- 录制规格（规格 §3.1.7）。**横排、不用下拉** ——
                             规格原话「编码与规格的选项要**横排**（**不用下拉**）」。
                             帧率没有选项：规格「上限 30 帧、不提供选择」。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="编码" VerticalAlignment="Center" Width="66"/>
                            <RadioButton x:Name="CodecH264" GroupName="Codec" Tag="H264"
                                         Content="H.264（兼容优先）" VerticalAlignment="Center"
                                         Checked="OnRecordingSpecChanged"/>
                            <RadioButton x:Name="CodecH265" GroupName="Codec" Tag="H265"
                                         Content="H.265（更省空间）" VerticalAlignment="Center"
                                         Margin="14,0,0,0" Checked="OnRecordingSpecChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="分辨率" VerticalAlignment="Center" Width="66"/>
                            <RadioButton x:Name="Res4K" GroupName="Resolution" Tag="Uhd4K"
                                         Content="4K" VerticalAlignment="Center"
                                         Checked="OnRecordingSpecChanged"/>
                            <RadioButton x:Name="Res1080" GroupName="Resolution" Tag="P1080"
                                         Content="1080P" VerticalAlignment="Center" Margin="14,0,0,0"
                                         Checked="OnRecordingSpecChanged"/>
                            <RadioButton x:Name="Res720" GroupName="Resolution" Tag="P720"
                                         Content="720P" VerticalAlignment="Center" Margin="14,0,0,0"
                                         Checked="OnRecordingSpecChanged"/>
                            <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                                       Foreground="#88666666" Text="帧率固定 30"/>
                        </StackPanel>

                        <!-- ⚠️ 规格：「**回落必须可见**……并**明确告诉用户实际用的是什么**。
                             **不得静默回落**」—— 这一行就是那个落点。 -->
                        <TextBlock x:Name="EffectiveSpecText" Margin="66,4,0,0" TextWrapping="Wrap"
                                   Foreground="#88666666" Text=""/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="StartWorkButton" Content="开始工作" Padding="18,6"
                                    IsEnabled="False" Click="OnStartWork"/>
                            <Button x:Name="StopWorkButton" Content="结束" Padding="18,6"
                                    Margin="8,0,0,0" IsEnabled="False" Click="OnStopWork"/>
                            <TextBlock x:Name="RecordingStatus" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" x:Name="NoticesText" Margin="0,12,0,0"
                           TextWrapping="Wrap" Foreground="#CC333333"/>
            </Grid>
        </TabItem>

        <!-- ── 检索与回放 ───────────────────────────────────── -->
        <TabItem Header="检索与回放">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="单号" VerticalAlignment="Center" Width="40"/>
                    <TextBox x:Name="SearchBox" Width="220" KeyDown="OnSearchKeyDown"/>

                    <ComboBox x:Name="MatchCombo" Width="110" Margin="8,0,0,0" SelectedIndex="1">
                        <ComboBoxItem Tag="Exact">精确</ComboBoxItem>
                        <ComboBoxItem Tag="Prefix">前缀</ComboBoxItem>
                        <ComboBoxItem Tag="Fuzzy">模糊</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="日期" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <DatePicker x:Name="FromDate" Width="130"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Margin="6,0"/>
                    <DatePicker x:Name="ToDate" Width="130"/>

                    <TextBlock Text="类型" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <ComboBox x:Name="BusinessCombo" Width="100" SelectedIndex="0">
                        <ComboBoxItem Tag="">全部</ComboBoxItem>
                        <ComboBoxItem Tag="Outbound">发货</ComboBoxItem>
                        <ComboBoxItem Tag="Return">退货</ComboBoxItem>
                    </ComboBox>

                    <Button x:Name="SearchButton" Content="检索" Padding="16,4"
                            Margin="14,0,0,0" Click="OnSearch"/>
                    <Button x:Name="OpenPlaybackButton" Content="局域网回放页" Padding="16,4"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnOpenPlayback"/>
                    <Button x:Name="OpenDataFolderButton" Content="数据目录" Padding="16,4"
                            Margin="8,0,0,0" IsEnabled="False" Click="OnOpenDataFolder"/>
                    <!-- 交付原视频（规格 §3.7）：**不转码、不压缩、不裁剪、不打码**。
                         选了列表里的一条之后点它。 -->
                    <Button x:Name="ExportButton" Content="导出原视频" Padding="16,4"
                            Margin="8,0,0,0" Click="OnExportResult"/>
                </StackPanel>

                <DataGrid x:Name="ResultsGrid" Grid.Row="1" Margin="0,12,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="OnResultSelected"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="150"/>
                        <DataGridTextColumn Header="单号" Binding="{Binding Waybill}" Width="160"/>
                        <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="80"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Business}" Width="70"/>
                        <DataGridTextColumn Header="会话" Binding="{Binding SessionId}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" x:Name="SearchStatus" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="#CC333333"/>
            </Grid>
        </TabItem>

        <!-- ── 设置 ─────────────────────────────────────────── -->
        <TabItem Header="设置">
            <StackPanel Margin="16">
                <TextBlock Text="连接电脑 / 手机" FontWeight="SemiBold"/>
                <Button x:Name="EnrollButton" Content="连接电脑/手机" Padding="16,6"
                        Margin="0,4,0,0" HorizontalAlignment="Left" Click="OnEnroll"/>
                <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                           Text="点开弹出一张二维码，手机端扫它来申请连接。申请到了由你决定同意还是拒绝 —— 没有这一步，手机换不到凭据，录像传不上来。"/>

                <TextBlock Text="分段时长（分钟）" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <TextBox x:Name="SegmentBox" Width="120" Margin="0,4,0,0"
                         HorizontalAlignment="Left"/>
                <TextBlock Text="单个分段的上限。到点自动滚下一段，用户无感。" Margin="0,2,0,0"
                           Foreground="#88666666" TextWrapping="Wrap"/>

                <!-- 时间校准（规格 §3.6.4）。**未校准不能开始录制** —— 所以它
                     必须摆在设置页里、说清三件事：为什么 / 怎么办 / 已有录像照常可用。 -->
                <TextBlock Text="时间校准" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="CalibrationNote" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="520"/>
                    <Button x:Name="CalibrateButton" Content="重新校准" Padding="12,4"
                            Margin="12,0,0,0" Click="OnCalibrate"/>
                </StackPanel>
                <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                           Text="为什么要它：视频里的时间必须能追溯到本机之外的某个来源 —— 靠本机时钟的话，改一下系统时间就能伪造「更早的证据」。联一次网取到时间之后，即使以后一直断网也能照常录制（时间是拿「校准那一刻 + 之后走了多久」推出来的，与系统时钟无关）。"/>
                <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                           Text="怎么办：点【重新校准】。取不到公网时间时，检查这台机器能不能上网（要能访问 https）。⚠️ 只有内网、从没联过公网的机器**开不了工** —— 这是需求方 2026-09-24 明确接受的代价。"/>
                <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                           Text="⚠️ 未校准**只挡住新录**：已有的录像照常可以检索、回放、导出、交付 —— 与许可那条红线（不得锁住已有录像）是同一条道理。"/>

                <TextBlock Text="回放服务端口" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBox x:Name="PortBox" Width="120" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                <TextBlock Text="改了要重启才生效。" Margin="0,2,0,0"
                           Foreground="#88666666"/>

                <TextBlock Text="归档层" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <ComboBox x:Name="ArchiveCombo" Width="200" Margin="0,4,0,0"
                          HorizontalAlignment="Left" SelectionChanged="OnArchiveChanged">
                    <ComboBoxItem Tag="LocalDisk">本机磁盘</ComboBoxItem>
                    <ComboBoxItem Tag="Nas">NAS</ComboBoxItem>
                    <ComboBoxItem Tag="MountedDrive">挂载网络驱动器</ComboBoxItem>
                    <ComboBoxItem Tag="Cloud">百度网盘</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="录像备份到哪儿去了。只有在别处还有一份时，清掉盘上这份才是安全的。"
                           Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"/>
                <TextBlock x:Name="ArchiveReachNote" Margin="0,2,0,0"
                           Foreground="#88666666" TextWrapping="Wrap"/>

                <!-- 目录型的路径（NAS / 挂载盘）。这两档**共用一份实现**（规格 §3.4.6），
                     所以界面上也是同一个输入框 —— 再拆一个只会让两条路慢慢走岔。 -->
                <StackPanel x:Name="ArchivePathPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="归档目录" FontWeight="SemiBold"/>
                    <TextBox x:Name="ArchivePathBox" Width="360" Margin="0,4,0,0"
                             HorizontalAlignment="Left"/>
                    <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="填一个可读写的目录，例如 \\nas\vidlog 或 Z:\vidlog。网络那一层（登录、凭据）由你在系统里挂好，我们只当成一个目录用。"/>
                    <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="⚠️ 这个路径只是「去哪儿找归档层」，不进索引 —— 换台机器挂到别的盘符，录像照样查得到。"/>
                </StackPanel>

                <!-- 归档层 = 本机磁盘时这块**不出现**（规格 §3.5.1）——
                     那时盘上这份是唯一副本，给了开关也只能是「改了没反应」。 -->
                <StackPanel x:Name="RetentionPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="本地保留期（发货 / 退货 × 已备份 / 未备份 = 四个数）" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,2,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="这份设置现在只是记下你的选择 —— 真正开删要等清理执行层接通（M6）。今天不会有任何文件被删。"/>

                    <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="发货" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="退货" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="已备份" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ArchivedOutboundCombo" Grid.Row="1" Grid.Column="1"
                                  IsEditable="True" Margin="0,2,8,2" SelectionChanged="OnRetentionChanged"/>
                        <ComboBox x:Name="ArchivedReturnCombo" Grid.Row="1" Grid.Column="2"
                                  IsEditable="True" Margin="0,2,0,2" SelectionChanged="OnRetentionChanged"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="未备份" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UnarchivedOutboundCombo" Grid.Row="2" Grid.Column="1"
                                  IsEditable="True" Margin="0,2,8,2" SelectionChanged="OnRetentionChanged"/>
                        <ComboBox x:Name="UnarchivedReturnCombo" Grid.Row="2" Grid.Column="2"
                                  IsEditable="True" Margin="0,2,0,2" SelectionChanged="OnRetentionChanged"/>
                    </Grid>

                    <TextBlock Margin="0,6,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="四个数互相独立，改一个不动另一个。以「已备份」为例：它从**归档成功那一刻**起算，不是从录完起算。"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="⚠️「不保留」不是立刻删：最近 24 小时内录的一律不动（硬性豁免，关不掉），所以它实际是「归档后最快 24 小时清理」。"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="⚠️「未备份」那一列**永不自动删除** —— 那是唯一副本，删了就永久没了。它到期的动作只有提醒（列表标红 + 催上传），起算点是**录完时刻**。"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"
                               Text="档位可以手输天数（例如 45）。⚠️「已备份 = 不保留」而归档层还没接上时，清理由 §3.5.4 的回查把关：查不到或查不了都**不删**。"/>
                </StackPanel>
                <TextBlock x:Name="RetentionAbsentNote" Margin="0,16,0,0"
                           Foreground="#88666666" TextWrapping="Wrap"/>

                <!-- 归档层那一份没发上去（规格 §3.4.6）。**必须说出来**：
                     它意味着盘上这份只有一份，而用户可能以为自己已经双份了。 -->
                <TextBlock x:Name="ArchiveRelayNote" Margin="0,16,0,0"
                           Foreground="#CC6600" TextWrapping="Wrap" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="SaveSettingsButton" Content="保存设置" Padding="16,6"
                            Click="OnSaveSettings"/>
                    <TextBlock x:Name="SettingsStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="需要注意" FontWeight="SemiBold" Margin="0,24,0,4"
                           x:Name="WarningsHeader" Visibility="Collapsed"/>
                <ListBox x:Name="WarningsList" MaxHeight="160"
                         HorizontalContentAlignment="Stretch" Visibility="Collapsed"/>

                <Button x:Name="ExportDiagnosticsButton" Content="导出诊断包"
                        Padding="16,6" Margin="0,16,0,0" HorizontalAlignment="Left"
                        Click="OnExportDiagnostics"/>
                <TextBlock Text="把日志、设置与环境信息打成一个 zip，不含任何视频。"
                           Margin="0,4,0,0" Foreground="#88666666" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
