<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VidLog.Desktop.Core\VidLog.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      程序图标（`VidLog.ico`，多尺寸 16/32/48/64/128/256，圆角外是**透明**的）。

      ⚠️ 同一个文件要编进去**两次**，两次去的不是同一个地方：
        `ApplicationIcon`（下面 PropertyGroup 里）→ exe 的 Win32 图标资源，
            管**资源管理器与任务栏**那一处；
        `Resource`（这里）→ 程序集里的 WPF 资源，管 `Window.Icon` 与托盘 ——
            那两处走的是 `Application.GetResourceStream`，**看不到** Win32 那份。
      少任何一条都会「有的地方有图标、有的地方没有」，而且都不报错。
    -->
    <Resource Include="VidLog.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      语音播报（闲置提醒，规格 §3.3.3 要的是「**语音播报**提醒」）。

      ⚠️ 这是本仓的**第二个** NuGet 依赖（第一个是 Core 的 ZXing，只做条码解码）。
      `System.Speech` 是微软自带的包 —— 它只是**调 Windows 语音引擎（SAPI）的门**，
      **不携带任何音频数据**，所以「不许引入音频素材文件」那条账没有被它破坏
      （与手机端走系统 TTS 是同一条理由）。

      为什么不用 `SpeechSynthesizer` 之外的招：托盘气泡**不是**语音，而规格写的是
      「语音播报提醒」；用户把窗口收进托盘时气泡还可能没被看见。两条一起出，
      见 `Platform/Speech.cs` 与 `App.xaml.cs` 的 OnNotice。
    -->
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      安装包的版本号（母仓 AGENTS.md §9.1：语义化版本 或 四段式；这里是**语义化**）。

      ⚠️ 这是全仓**唯一**一处版本声明 —— 在这之前一个都没有，打出来的 exe 一直是
      FileVersion 1.0.0.0（那个数没有任何意义，也不会随改动变）。

      它同时决定 FileVersion 与 ProductVersion：
        FileVersion    = 0.2.0.0        （AssemblyVersion 那个 4 段形状，SDK 自动补 0）
        ProductVersion = 0.2.0+<git sha>（`+` 后面那截是 SDK 自己加的构建元数据，是合法 semver）

      ⚠️ 改版本号就改这一行。0.1.0 是第一个版本（还没发布过正式版，1.0.0 留给
      第一次正式对外）。

      0.2.0（2026-10-01）：界面照需求方设计图重做（批次 1~9，含配置向导、
      多磁盘、百度网盘归档、本机角色、导入导出、实时多画面）——
      在 0.x 里**加功能是次版本号**，所以是 0.2.0 而不是 0.1.1。

      0.2.1（2026-10-03）：只修缺陷，不加功能 —— 用途选择窗不再被「有设置文件」
      吞掉、多画面恢复九宫格摆法、预录目录由控制器自己建出来、几处文字不再被按钮盖住、
      播不了时的说明改成实话。同一版号重出安装包会让两份包分不出来，所以补第三位。

      0.2.2（2026-10-03）：还是只修缺陷。安装程序多放行一条防火墙入站规则 ——
      回放服务绑的是 http.sys，Windows 那个「允许访问」的弹窗根本不会出现，
      于是 urlacl 有了、界面一切正常，手机发的请求却在防火墙这一层被丢掉，
      而电脑端一个字都不显示（报上来的就是「手机报连不上、电脑端不提示同意」）。
      ⚠️ **0.2.1 装出来的那份没有这条规则**，所以这一版必须换个号，
      否则「装没装到新版」从版本号上看不出来。

      0.3.0（2026-10-03）：加功能 —— **许可整条路第一次真的通了**。
      ① 公钥编进程序（原先只认环境变量，装机时没人设 ⇒ 机位恒为 0 ⇒
      手机扫码后电脑端一个字都不显示，报上来的缺陷就是这个）；
      ② 试用码（7 天 / 4 机位），要客户在【许可】里输码，不是新装默认进试用；
      ③ 试用到期后连**已经在册**的那台手机也不再上报实时画面。
      按 0.x 的惯例，加功能是次版本号 ⇒ 0.3.0。

      0.4.0（2026-10-03）：又加功能 —— ① 手机端推流到电脑端的实时多画面不再卡死
      （掉线的格子会重连、恢复时点名要关键帧，这一版既改了电脑端也改了手机端）；
      ② 设置页【关于】里的日志导出分成「保存到本地」与「发送到开发者邮箱」两条路。
      按 0.x 的惯例，加功能是次版本号 ⇒ 0.4.0（不是 0.3.1）。

      ⚠️ 手机端同期还改了【发货】/【退货】两页右上角的实时共享开关，并加了手电筒按钮
      —— 那是**纯手机端**的改动，电脑端一行没动，不算在这里的升版理由里。

      0.4.1（2026-10-03）：只修缺陷。0.4.0 那一版只做到「断了就重连」（最多 3 次），
      装上去缺陷照旧 —— 真正的形状是下面三条，本版是那一版的收口（细节见 `b393a59`）：
      ① 多画面窗口开出来之后**再也不跟手机走**（手机每开一次共享就换一个端口，而格子
      钉死在**开窗那一刻**的地址上 ⇒ 手机在推、那一格一直黑，只能关窗重开）；
      ② 上限 3 次等于死路（改成 30 秒封顶、翻倍退避、**一直试**，只是满 3 次后不再刷屏）；
      ③ 断了之后 `Latest()` 一直返回最后那一帧，**冻帧冒充画面**（超过 3 秒没有新帧就
      当作没有画面）。按 0.2.1 那条同样的理由，修缺陷补第三位。

      0.4.2（2026-10-05）：只修缺陷，不加功能。MJPEG over HTTP 那类网络摄像头
      （手机 IP 摄像头、本机摄像头推的流）录出来的时长不再虚长 —— 这类流**不带时间戳**，
      ffmpeg 只能按 `mpjpeg` 解复用器**写死的 25fps** 打戳，而真源实测 28~32fps
      ⇒ 媒体时钟比墙钟快 14%~28%，表现是文件比事件长、播放慢动作、烧进画面的水印时钟
      比真实时间快、索引里的时刻全偏。非 RTSP 的网络源改成**按墙钟打戳**；
      RTSP 不动（它自带真时间戳）。修的是缺陷不是功能，所以补第三位。

      0.5.0（2026-10-07）：加功能，按 0.x 的惯例走次版本号 ⇒ 0.5.0（不是 0.4.3）。
      三件看得见的：
      ① **多画面九格墙**（T9）：分割档位 1 / 4 / 9 / 16；每格一颗「眼睛」单独停那一路；
      全屏里再双击返回；最小化时一并停。⚠️ 关掉的那格**位置照占**（不重排），
      所以「已关闭」与「没接入」是两种画法，一眼分得出。
      ② **跟随系统切暗色**：亮暗两套色盘，系统换主题时同一个进程里跟着换
      （连向导与启动画面、DWM 标题栏都跟着）；四对达不到对比度的配色是**量着**修掉的，
      亮色那一套因此一个像素都没动。
      ③ 设置页补上**【清理流水…】**入口：清理动作的审计本来写了三轮，但用户看不到
      —— 现在时间 / 单号 / 动作 / 原因四列在界面上能翻页看。
      另外把两套蓝合并成一套 `blue-600`（同一个角色原来有两个蓝）。

      ⚠️ 这一版还捎带收口了一批缺陷（都不是新功能）：桌面自录的那一份不进清理账
      ⇒ 永远清不掉（T18）；没发上去的归档不落盘 ⇒ 重启就看不见（T23-A）；
      保留期手输超大数会把整份设置打回默认值；自动上传那颗章从来没盖过；
      被限流时日志说了句谎（「对端还没有发布过任何版本」）。另有大量**不改行为**的
      内部搬运（T27② 那一批把判断与拼句搬进 Core、T26 把几个大类拆成 partial）
      混在同一段提交里。

      ⚠️ 手机端同期也接了暗色与圆角令牌 —— 那是**纯手机端**的改动，不算在这里的升版理由里。

      0.6.0（2026-10-08）：加功能 ⇒ 0.6.0（不是 0.5.1）。
      0.5.0 那版只做到「跟随系统」—— 要换色得去改 Windows 的「应用模式」，
      而设置页「外观主题」那一行还挂着做暗色主题**之前**写的字（三个选项的说明全是过期的、
      选中的是「浅色」），等于在说一句假话。这一版把它改成真开关：
      **跟随系统 / 浅色 / 深色** 三档，选中就落盘、存下去当场换色（不必重启），
      下面那句话会把「跟随系统现在跟出什么颜色」说出来。
      ⚠️ 老设置文件里没有这一项 ⇒ 取默认的「跟随系统」= 做出这三档之前的行为，
      所以升级上来的机器**界面一个像素都不会变**（这一条有测试钉着）。
      ⚠️ 固定成浅色/深色之后，改 Windows 主题不再掀掉你选好的那一档。

      0.7.0（2026-10-09）：加功能 ⇒ 0.7.0（不是 0.6.1）。
      ① **归档补发**（T23-B）：目录型的归档目标（NAS / 挂载盘）从前**没有落盘重传
      队列** —— 发布只在收尾那一刻发生一次，那一次没发上去就是**永久的**。后果不是
      丢证据（回查拒删），是**盘会满**：那条永远清不掉，而用户以为已经双份。现在
      启动时遍历那本失败账、逐条重发（**不 await** —— 掉线的 NAS 不能把关窗卡住），
      本机那份不在了就跳过、但账不划掉，没欠账时一条日志都不记。
      ② **实时画面这一路收口了四处**，其中三处都属于「计数器在说谎」那一类：
      「界面丢了」不再恒读 20–28%（画帧那一处要走「取走」）；帧率改按**墙上时钟**
      算（手机推的是裸 H.264，ffmpeg 只会按默认 25 fps 猜）；取帧节拍 12 → **20 fps**
      —— 从前取帧与出帧两个钟同频、丢帧率只看相位，真机实测正落在 14.6%（收 501 /
      丢 73），抬上去之后同一条管道是收 1244 / 丢 6（**0.48%**）。还有一处是那一格
      从前会「从头到尾只出一帧」（T16 取证）。
      ⚠️ 另修一条**与画面无关但更要紧**的：读 ffmpeg 文本的管道原先没声明编码，
      **中文名的采集设备会录成无声**（CI 抓不到 —— 同一份代码 CI 绿、本机红）。
      ③ 界面上把**内部代号**（`I8` / `§3.5.4` / `M6`）从用户看得见的地方撤掉；
      程序图标三处一起换（exe 资源/窗口/托盘，少一处就会「有的地方有、有的地方没有」）、
      窗口大标题统一成 28 加粗。

      ⚠️ 验收时**别把「丢帧那个数变小了」当成画面变好了**：是账变真了，
      不是画面变了 —— 画面那一侧真变的是取帧节拍（20 Hz）。
      ⚠️ 手机端同期也在动，那不算在这里的升版理由里。
    -->
    <Version>0.7.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      只为托盘图标（System.Windows.Forms.NotifyIcon）而开。
      Windows Desktop SDK 自带，**不加任何 NuGet 包**。
      不用它的话就得手写 Shell_NotifyIcon 的 P/Invoke —— 代码多好几倍，
      而换来的只是「不引用 WinForms」，没有实际收益。
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 图标文件的另一份去处，见上面那个 ItemGroup 的说明。 -->
    <ApplicationIcon>VidLog.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
