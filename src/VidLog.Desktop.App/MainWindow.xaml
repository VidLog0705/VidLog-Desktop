<Window x:Class="VidLog.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VidLog.Desktop.App"
        mc:Ignorable="d"
        Title="VidLog · 工位录像" Height="780" Width="1320" MinWidth="1100" MinHeight="660"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource PageBackground}"
        Closing="OnClosing">
    <!--
        ════════════════════════════════════════════════════════════════
        「录制台」—— 照需求方自绘的界面图（2026-09-28）

        ▓▓ 版式 ▓▓
          顶栏   ：[当前类型] [扫码输入 .................✕] [开始录制]
          左主体 ： 深色预览区  + 底部统计条（今日 N 件 · 平均 N 秒 · 总耗时）
          右侧栏 ： 本机录制动态（原来的「概览」页收进来了）+ 连接手机入口

        ⚠️ 这**取代**了 2026-09-28 早先那版 SaaS 版式（左 216px 竖导航 +
        右侧四页切 Visibility）。那版整个作废 —— 四个页面拆成了两个独立窗口
        （设置 → `SettingsWindow`，检索与回放 → `SearchWindow`），
        剩下的「概览」收进右侧面板。`docs/实现决策.md` §58 的版式裁决作废。

        ▓▓ 有意与设计图不一样的两处（都不是「偷懒」，是功能不能丢）▓▓
        ① **编码 / 分辨率不在这一页**：规格 §3.1.7 要求「横排、不用下拉」，
           它们挪进了设置窗的「设备与外观」—— 录制台上摆不下，而图上也没有。
        ② **预览区现在没有真画面**：dshow 相机是独占的，录制进程开着的时候
           取不到第二路画面（见 `docs/实现决策.md` §25）。真预览要单独验一次
           相机能不能「一路源两路输出」，验过之前这里如实写着「未接入」。

        ⚠️ 顶部那个「发货 / 退货」按钮**曾经是禁用的** —— 当时的理由写在这里：
        「VidLog 里业务类型是手机端扫单号时定的，电脑端没有这个状态」，
        并标明**要需求方裁决**。
        2026-09-30 裁决落地：**设计图优先** —— 图 `_35` 上它就在那儿、
        右栏还配着两张命令条码（扫码切换退货 / 扫码开始录像），
        所以电脑端**现在有**这个状态了（`RecordingCoordinator.CurrentBusinessType`），
        开段那一刻抄进会话、收尾时写成 `LabelKeys.BusinessType` 标签。
        ⚠️ 与手机端定的那个标签**同一套值**（`BusinessTypes`），不是两套。
        详见 `docs/实现决策.md` 的「批次 6」一节。

        ⚠️ 有四段文字被绊线测试**按文本**盯着（`DesktopServicesTests`），
        必须逐字保留：`x:Name="DurationStopButton"` /
        `x:Name="DurationContinueButton"` / `Click="OnDurationStop"` /
        `Click="OnDurationContinue"`。
        （另外两条 `Click="OnToggleLock"` / `Tag="{Binding EvidenceId}"`
        随检索页搬去了 `SearchWindow.xaml`，测试跟着改读那个文件。）
        ════════════════════════════════════════════════════════════════
    -->
    <!--
        ⚠️ 外面这一层是为了「备份主机」那个形态（设计图 `_39`）新加的：
        本机用途不录像时，显示的是 `BackupRoot` 而不是录制台。
        **两层各自完整，靠 Visibility 二选一** —— 不把录制台里那近九十个
        `x:Name` 搬来搬去（那正是最容易搬崩的地方，而 App 层没有测试挡得住）。
    -->
    <!--
        ⚠️ 2026-10-04（改造清单 T13）：外面这层多了第 2 行 —— **常驻状态栏**。
        它挂在 `RecordingRoot` / `BackupRoot` **之外**，所以两种用途下都在：
        切到「备份主机」时左边那一栏整个没了，那时磁盘余量、在线机位、
        端口这三样本来**一处都看不到**。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <Grid x:Name="RecordingRoot" Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 顶栏 ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ① 当前业务类型（图 `_35` 左上角那颗蓝按钮）。
                     点一下切换发货 / 退货；**改的只是「下一段按哪个档录」**，
                     正在录的这一段不跟着变（见 `RecordingCoordinator.CurrentBusinessType`）。
                     同样的切换也能拿扫码枪扫右栏那张码 —— 对工位上腾不出手的人，
                     那才是主路径，这颗按钮是给够得着鼠标的人用的。 -->
                <Button x:Name="BusinessButton" Grid.Column="0"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,10" Click="OnToggleBusinessType"
                        ToolTip="点一下切换「发货 / 退货」。录起来之后改它只对下一段生效 —— 正在录的这一段按开始时的档位。">
                    <StackPanel Orientation="Horizontal">
                        <!-- 包裹盒：内联矢量，不引任何图片资源 -->
                        <Path Data="M 8,0 L 16,4.5 L 16,12 L 8,16.5 L 0,12 L 0,4.5 Z M 8,0 L 8,16.5 M 0,4.5 L 8,8.5 L 16,4.5"
                              Stroke="White" StrokeThickness="1.4"
                              VerticalAlignment="Center"/>
                        <TextBlock x:Name="BusinessLabel" Text="发货" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource TextSizeEmphasis}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- ② 扫码输入。⚠️ 提示文字是**覆盖层**，不是 TextBox 的占位符
                     （WPF 没有那个属性），所以它必须 `IsHitTestVisible="False"`
                     才不会把点击吃掉。 -->
                <Grid Grid.Column="1" Margin="12,0">
                    <TextBox x:Name="WaybillBox" Background="{DynamicResource PageBackground}"
                             BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                             Padding="14,9" FontSize="{StaticResource TextSizeEmphasis}" IsEnabled="False"
                             VerticalContentAlignment="Center"
                             TextChanged="OnWaybillChanged"/>
                    <TextBlock Text="支持后台扫码，也可手动输入"
                               Margin="16,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDisabled}" FontSize="{StaticResource TextSizeEmphasis}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=WaybillBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- ✕ 清除。单号非空时才出现（空的时候摆个 ✕ 是噪声）。 -->
                    <Button x:Name="ClearWaybillButton" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Width="28" Height="28"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondary}"
                            Click="OnClearWaybill">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=WaybillBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- ③ 开始 / 结束。
                     ⚠️ 绿色是图上量出来的 emerald-500（`Success`）。
                     ⚠️ **一个按钮兼三态**：图上顶栏只有一个绿色「开始录制」，
                     没有单独的停止按钮 —— 它自己换字换底色（`RefreshStartButton`
                     里切，字与颜色一起换）：
                       没在工作 ⇒ 绿底【开始录制】（框里没单号时按下去是**开始工作**，
                                  进待扫态等扫码枪 —— 从前那种情况这一颗是灰的，B1）
                       待扫（工作上、还没扫到面单）⇒ 红底【结束工作】
                       录制中 ⇒ 红底【停止录制】
                     ⚠️ 待扫态要是**框里还留着上一段的单号**，它仍是【开始录制】——
                       那一下是「用这个单号再录一段」，与第三态的分界见 `StartButton.Kind`。 -->
                <Button x:Name="StartWorkButton" Grid.Column="2"
                        Style="{StaticResource SuccessButton}"
                        Padding="22,10" IsEnabled="False" Click="OnStartOrStopWork">
                    <StackPanel Orientation="Horizontal">
                        <Grid VerticalAlignment="Center" Width="16" Height="16">
                            <Ellipse Stroke="White" StrokeThickness="1.6"/>
                            <Ellipse Fill="White" Width="6" Height="6"/>
                        </Grid>
                        <TextBlock x:Name="StartWorkLabel" Text="开始录制" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource TextSizeEmphasis}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ 主体 ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左：预览 + 统计条 ──────────────────────────────── -->
            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource VideoBackground}"
                        CornerRadius="{StaticResource RadiusCard}">
                    <Grid x:Name="PreviewArea">
                        <!-- 取景画面（§62）。帧从**两个**源头来，但都投进同一只单槽：
                             录制中＝采集进程的第二路输出（彩色、12 fps），
                             工作中待扫＝取景识码那一路顺带投的帧。
                             ⚠️ 两路**都是彩色**（2026-10-09 A1 之前待扫那一路是灰度 3 fps），
                             只是框不一样大（待扫 640×480、录制 640×360）。
                             ⚠️ `Uniform` 而不是 `Fill`：`Fill` 会把画面**拉变形**
                             （与配置向导预览区同一条理由）。帧本身已经是 16:9
                             且四周补过黑边，所以等比缩放之后剩下的黑边与视频底同色。
                             ⚠️ 一开始藏着 —— 没帧的时候该露出来的，是下面那句说明。 -->
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- 识别框（需求方 2026-10-10）：**四个角各一段实线直角、互不相连**。
                             它标的正是喂解码器的那一片（`RecognitionRoi.Default`）——
                             所以它不是一个「大概齐」的提示，画在哪儿就意味着只认哪儿。
                             ⚠️ 位置**算出来**（`RecognitionBox.Fit`）而不是钉在 XAML 上：
                             画面是等比缩放进这个格子的，两种帧尺寸（640×480 / 640×360）
                             留下的黑边不一样宽。
                             ⚠️ 颜色**不新增调色板条目**：这里用的白与上面那个时间戳同一个口径
                             （画面上的白色覆盖物在本项目的既有做法）。 -->
                        <Path x:Name="RecognitionBoxPath" Visibility="Collapsed"
                              IsHitTestVisible="False"
                              Stroke="White" StrokeThickness="3"
                              StrokeLineJoin="Miter" StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"/>

                        <!-- 实时时间。⚠️ 这是**可信时钟**的时间，不是系统时钟 ——
                             改系统时间也改不动它，与录像里烧的那个是同一个来源。
                             ⚠️ 颜色**不在这里给**：可信（白）与未校准（警示色）
                             由 `UpdatePreviewClock` 一处决定 —— 这里再写一份的话，
                             「哪种状态是什么色」就有两个来源了。 -->
                        <TextBlock x:Name="PreviewClockText" Margin="0,12,16,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource TextSizeBody}"
                                   Text=""/>

                        <StackPanel x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource TextDisabled}" StrokeThickness="1.6"/>
                                <Path Data="M 18,15 L 30,22 L 18,29 Z" Fill="{DynamicResource TextDisabled}"/>
                            </Grid>
                            <!-- ⚠️ 这句原来是「实时预览未接入」—— 画面接上之后它就成了假话
                                 （空框与「坏了」「还没开始」三种情况本来就长得一样，
                                 而它只在最后一种下成立）。改成中性的栏目名，
                                 为什么没有画面由下面那句说清楚。 -->
                            <TextBlock Text="实时预览" Margin="0,14,0,0"
                                       HorizontalAlignment="Center" FontSize="{StaticResource TextSizeEmphasis}"
                                       Foreground="White"/>
                            <TextBlock x:Name="PreviewHintText" Margin="0,6,0,0"
                                       MaxWidth="520" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextDisabled}" Text=""/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 时长兜底那次**询问**（规格 §3.3.4）。
                     ⚠️ 默认藏着 —— 只有真到了档位时间才出现。
                     ⚠️ 措辞与手机端**逐字一致**（【停止】/【继续】）。
                     ⚠️ 它**不打断录制** —— 只是页面里的一条，不弹窗、不挡取景。 -->
                <Border x:Name="DurationPromptPanel" Grid.Row="1" Margin="0,10,0,0"
                        Padding="14,10" CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource WarningSurface}"
                        BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="录制时间即将超时，是否需要停止录制？"/>
                        <Button x:Name="DurationStopButton" Content="停止" Padding="16,5"
                                Margin="16,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="OnDurationStop"/>
                        <Button x:Name="DurationContinueButton" Content="继续" Padding="16,5"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnDurationContinue"/>
                    </StackPanel>
                </Border>

                <!-- 底部统计条 -->
                <Border Grid.Row="2" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}" Padding="16,10" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TodayCountText" Style="{StaticResource Body}"
                                       Text="今日 0 件"/>
                            <TextBlock x:Name="TodayAverageText" Style="{StaticResource Body}"
                                       Margin="18,0,0,0" Text="平均 0 秒"/>
                            <TextBlock x:Name="TodayTotalText" Style="{StaticResource Body}"
                                       Margin="18,0,0,0" Text="总耗时 0 秒"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DataButton" Content="数据"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Click="OnOpenData"/>
                            <Button x:Name="OpenSearchButton" Content="回放"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="8,0,0,0" Click="OnOpenSearch"/>
                            <!-- ⚠️ **它现在是可以点的**（2026-10-01）。此前一直灰着，
                                 理由是「还没做」；那一半（窗口 / 取流 / 画质档 / 计数 /
                                 手机报到）已经做完了。
                                 ⚠️ **不给它加「有没有机位」的禁用条件**：一架飞机都没有时
                                 画面上是九格「无信号输入」，而那是设计图里**正常的一种样子**
                                 （机位不够时空格就画那四个字），不是错误状态。
                                 悬停说明的是「怎么让它出现」。 -->
                            <Button x:Name="MultiViewButton" Content="实时多画面"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="8,0,0,0" Click="OnOpenMultiView"
                                    ToolTip="看每台手机现在的实时画面。手机端在「设置 → 实时共享」里打开之后才会出现在这里。"/>
                            <Button x:Name="OpenSettingsButton" Content="设置"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="8,0,0,0" Click="OnOpenSettings"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── 右：本机录制动态 ───────────────────────────────── -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- ══ 扫码切换发货 / 退货（图 `_35` 右栏上半）══════════
                             ⚠️ 载荷由 `ScanCommand.For(当前档)` 一处产出（切到**另一档**），
                             标题也跟着它变 —— 图上写的是「扫码切换退货」（那一刻录的是发货）。
                             ⚠️ 画码用 `BitmapScalingMode="NearestNeighbor"`：与
                             `EnrollWindow` 那张二维码同一条理由，插值会把条空边界糊成灰边，
                             表现是「看着像条码、扫不出来」。**那个属性别动。**

                             ⚠️ `Stretch="Fill"` **也不能删**（向导第 6 步那张码同样有它）。
                             `Code128.Modules` 返回的矩阵是 `[宽, 1]` —— 高度只有 1 个像素，
                             宽高比是 110:1。`Image` 的 `Stretch` 默认是 `Uniform`（保持宽高比），
                             于是 `Height="64"` 被**无声忽略**，整张码被压成 220×**2** 的一条细线，
                             屏幕上根本扫不出来。实测过一次：`w=220 h=2`。 -->
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="BusinessBarcodeTitle"
                                           Style="{StaticResource SectionTitle}"
                                           HorizontalAlignment="Center" Text="扫码切换退货"/>
                                <TextBlock x:Name="BusinessBarcodeHint"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Border Background="White" Padding="8" Margin="0,8,0,0"
                                        CornerRadius="{StaticResource RadiusControl}" HorizontalAlignment="Center"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1">
                                    <Image x:Name="BusinessBarcodeImage" Height="64"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock x:Name="BusinessBarcodePayload"
                                           Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </Border>

                        <!-- 录制状态。⚠️ 它原来在左侧竖导航里，那栏没了之后
                             必须有新家 —— 不然「现在到底在不在录」就没地方看了。 -->
                        <Border Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}" Padding="12,10">
                            <StackPanel>
                                <TextBlock x:Name="NavRecordingText" FontSize="{StaticResource TextSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="空闲"/>
                                <TextBlock x:Name="RecordingStatus" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="NavClockText" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" Text="校准状态未知"/>
                                <TextBlock x:Name="NavLicenseText" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" Text="许可状态未知"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="本机录制动态"
                                       Margin="0"/>
                            <Button x:Name="OvRefreshButton" Content="刷新" Margin="10,0,0,0"
                                    Padding="10,3" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OnRefreshOverview"/>
                        </StackPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}"
                                       Text="今日收录" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OvTodayText"
                                       Style="{StaticResource Body}" Text="统计中…"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="索引总量" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OvIndexText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Text="统计中…"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="录像库容量"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OvLibraryText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Text="统计中…"/>
                        </Grid>

                        <TextBlock x:Name="OvUpdatedText" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" Text=""/>

                        <Separator Margin="0,14,0,12"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="本机状态"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}"
                                       Text="采集相机" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OvCameraText"
                                       Style="{StaticResource Body}" Text="…"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="回放服务" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OvServerText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="归档层" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OvArchiveText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="数据盘" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="OvDiskText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Text="已入网设备"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="OvDevicesText"
                                       Style="{StaticResource Body}" Margin="0,6,0,0" Text="…"/>

                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="StatusText"
                                       Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="正在启动…"/>
                        </Grid>

                        <!-- 待办：没有内容时整张卡藏起来，不摆一个「0 条」占地方 -->
                        <Border x:Name="OvTodoCard" Margin="0,14,0,0" Padding="12,10"
                                CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource WarningSurface}"
                                BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="需要注意"/>

                                <!-- ⚠️ 左边标签的可见性**跟着右边值走**：值为空时
                                     整行（含标签）一起收掉，否则卡片上会挂几条
                                     「有标签、没内容」的空白行。
                                     理由见 Theme.xaml 里 `ValueLine` 那段注释。 -->
                                <TextBlock Grid.Row="0" Style="{StaticResource Caption}"
                                           Text="待清理" VerticalAlignment="Center"
                                           Visibility="{Binding ElementName=OvCleanupText, Path=Visibility}"/>
                                <TextBlock x:Name="OvCleanupText"
                                           Style="{StaticResource ValueLine}" Text=""/>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="未备份逾期"
                                           Visibility="{Binding ElementName=OvOverdueText, Path=Visibility}"/>
                                <TextBlock x:Name="OvOverdueText"
                                           Style="{StaticResource ValueLine}" Margin="0,4,0,0" Text=""/>

                                <TextBlock x:Name="OvWarningsText"
                                           Style="{StaticResource CaptionLine}" Margin="0,8,0,0"
                                           Text=""/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,14,0,12"/>

                        <Button x:Name="EnrollButton" Content="连接电脑 / 手机"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Click="OnEnroll"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="手机要接进来，得先在这里发一张二维码给它扫。"/>

                        <Separator Margin="0,14,0,12"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="动态"/>
                        <TextBlock x:Name="NoticesText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <!-- ══ 扫码开始录像（图 `_35` 右栏最底下）══════════════
                             ⚠️ 它等于按一下顶栏那颗按钮（`StartWork()`），
                             **不是**直接开录 —— 开录仍然要扫到一张真面单。
                             ⚠️ 载荷固定（`ScanCommand.StartWork`），不随档位变。
                             ⚠️ 那句括注「（那一颗要求单号框里已经有单号。）」**已删**
                             （B3，2026-10-09）：B1 之后顶栏那颗没单号也能点了，
                             再留着就是一句假话 —— 而这句话正是在教用户怎么用那张码。 -->
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           HorizontalAlignment="Center" Text="扫码开始录像"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="等同于按一下上面的【开始录制】；之后扫面单才会开录。"/>
                                <Border Background="White" Padding="8" Margin="0,8,0,0"
                                        CornerRadius="{StaticResource RadiusControl}" HorizontalAlignment="Center"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1">
                                    <Image x:Name="RecordBarcodeImage" Height="64"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock x:Name="RecordBarcodePayload"
                                           Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

    <!-- ══════════════════════════════════════════════════════════════
         「备份主机」形态 —— 照设计图 `_39`

         ⚠️ 什么时候显示它：`AppSettings.StationRole` 是「不要录像」的那两档
         （`BackupHost` / `ViewerOnly`）。**录制台整个收起来**，不是禁用 ——
         一台不录像的机器上摆着「开始录制」只是噪声。
         ⚠️ 图上那六颗按钮里有三颗（安装订单联动 / 发送测试订单 / 实时多画面）
         VidLog 没有对应能力，按裁决**禁用 + 悬停写明原因**，不是画个假的。
         ══════════════════════════════════════════════════════════════ -->
    <Grid x:Name="BackupRoot" Grid.Row="0" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 顶栏：机器名 + 地址 + 切换用途 ───────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BackupMachineText" FontSize="{StaticResource TextSizeStat}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Text="电脑"/>
                        <!-- 图上是灰字、与机器名同一行的**下沿对齐** -->
                        <TextBlock x:Name="BackupAddressText" Margin="12,0,0,0"
                                   VerticalAlignment="Bottom" FontSize="{StaticResource TextSizeSubhead}"
                                   Foreground="{DynamicResource TextSecondary}" Text=""/>
                    </StackPanel>
                    <TextBlock x:Name="BackupRoleText" Style="{StaticResource BodySecondary}"
                               Margin="0,8,0,0"/>
                    <!-- ⚠️ 图上没有这一行（设计图 `_39`），是**补的**：
                         备份主机不录像，但**照样吃机位**（手机的录像要传进来），
                         而「试用还剩几小时 / 已到期」正是这台机器上唯一会被追问的事。
                         不显示就只剩「手机上扫码没反应」这一个可见症状。
                         与录制台那行同一个来源（`StatusSummaries.License`），不另写一份。 -->
                    <TextBlock x:Name="BackupLicenseText" Style="{StaticResource BodySecondary}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button x:Name="SwitchRoleButton" Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButton}" Padding="14,7"
                        Click="OnSwitchRole">
                    <StackPanel Orientation="Horizontal">
                        <!-- ⇄：两条带箭头的反向横线，内联矢量 -->
                        <Path Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" VerticalAlignment="Center"
                              Data="M 0,4.5 L 13,4.5 M 10,1.5 L 13,4.5 L 10,7.5
                                    M 13,11.5 L 0,11.5 M 3,8.5 L 0,11.5 L 3,14.5"/>
                        <TextBlock Text="切换用途" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── 主体：左边两张状态卡 + 右边六颗按钮 ───────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}"
                        Padding="16,14" Margin="0,0,10,0" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- 手机 / 电脑备份 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Data="M 0,5.5 A 9,9 0 0 1 14,5.5
                                            M 2.8,8.5 A 5.5,5.5 0 0 1 11.2,8.5
                                            M 5.4,11.5 A 2.4,2.4 0 0 1 8.6,11.5
                                            M 6,14.5 A 1,1 0 1 0 8,14.5 A 1,1 0 1 0 6,14.5 Z"/>
                                <TextBlock Text="手机/电脑备份" Margin="8,0,0,0"
                                           FontSize="{StaticResource TextSizeEmphasis}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <!-- 图上「已就绪」是绿的、右对齐 -->
                            <TextBlock x:Name="BackupDeviceTag" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="{StaticResource TextSizeCaption}"
                                       Foreground="{DynamicResource Success}" Text="已就绪"/>
                        </Grid>
                        <TextBlock x:Name="BackupDeviceText" Style="{StaticResource BodySecondary}"
                                   Margin="0,9,0,0" Text="暂无手机/电脑设备"/>

                        <Separator Margin="0,14,0,12"/>

                        <!-- 订单联动 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Data="M 2,7 A 5,5 0 1 1 7,12 L 2,12 L 2,7 Z"/>
                                <TextBlock Text="订单联动" Margin="8,0,0,0"
                                           FontSize="{StaticResource TextSizeEmphasis}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="BackupOrderTag" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="{StaticResource TextSizeCaption}"
                                       Foreground="{DynamicResource Warning}" Text="暂无设备"/>
                        </Grid>
                        <TextBlock x:Name="BackupOrderText" Style="{StaticResource BodySecondary}"
                                   Margin="0,9,0,0" Text="暂无订单接收设备"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Margin="0,0,6,10"
                            Style="{StaticResource SecondaryButton}" Padding="16,12"
                            Click="OnEnroll">
                        <StackPanel Orientation="Horizontal">
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center"
                                  Data="M 0,5.5 A 9,9 0 0 1 14,5.5
                                        M 2.8,8.5 A 5.5,5.5 0 0 1 11.2,8.5
                                        M 5.4,11.5 A 2.4,2.4 0 0 1 8.6,11.5
                                        M 6,14.5 A 1,1 0 1 0 8,14.5 A 1,1 0 1 0 6,14.5 Z"/>
                            <TextBlock Text="连接电脑/手机" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1" Margin="6,0,0,10"
                            Style="{StaticResource SecondaryButton}" Padding="16,12"
                            Click="OnOpenPlaybackPage">
                        <StackPanel Orientation="Horizontal">
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M 2,1 L 13,6.5 L 2,12 Z"/>
                            <TextBlock Text="网页回放" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- ⚠️ 这两颗从**禁用**改成**可点**了（需求方 2026-10-01 裁决）：
                         没做的功能留入口、点开**如实说一句**。这推翻了先前那条
                         「禁用 + 悬停写明原因」（那一条只有鼠标悬停才看得见，
                         而触屏 / 不悬停的用户永远不知道它为什么点不动）。
                         订单联动要一个至今没开工的服务端（规格记在 M6），
                         不是这边少写了几行。 -->
                    <Button Grid.Row="1" Grid.Column="0" Margin="0,0,6,10"
                            Style="{StaticResource SecondaryButton}" Padding="16,12"
                            Click="OnInstallOrderLink">
                        <StackPanel Orientation="Horizontal">
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center"
                                  Data="M 2,7 A 5,5 0 1 1 7,12 L 2,12 L 2,7 Z"/>
                            <TextBlock Text="安装订单联动" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" Margin="6,0,0,10"
                            Style="{StaticResource SecondaryButton}" Padding="16,12"
                            Click="OnSendTestOrder">
                        <StackPanel Orientation="Horizontal">
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M 1,7.5 L 12,1.5 L 12,13.5 Z M 1,1.5 L 1,13.5"/>
                            <TextBlock Text="发送测试订单" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- ⚠️ 这颗原来灰着，理由已经消失（2026-10-01：手机报到那一半做完了）。
                         与上面那颗是**同一个处理函数**（`OnOpenMultiView`）——
                         它自己会把已经开着的那一个叫到前面，不会开出第二个来。 -->

                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0"
                            Style="{StaticResource SecondaryButton}" Padding="16,12"
                            Click="OnOpenMultiView"
                            ToolTip="看每台手机现在的实时画面。手机端在「设置 → 实时共享」里打开之后才会出现在这里。">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Data="M 0,2 L 7,2 L 7,10 L 0,10 Z M 7,4.5 L 11,2 L 11,10 L 7,7.5 Z"/>
                            <TextBlock Text="实时多画面" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ── 底栏：两个计数 + 三颗入口 ─────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="今日备份" FontSize="{StaticResource TextSizeSubhead}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="BackupTodayText" Text="0" Margin="8,0,0,0"
                               FontSize="{StaticResource TextSizeStat}" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="个" FontSize="{StaticResource TextSizeSubhead}" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="累计备份" FontSize="{StaticResource TextSizeSubhead}" Margin="26,0,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="BackupTotalText" Text="0" Margin="8,0,0,0"
                               FontSize="{StaticResource TextSizeStat}" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="个" FontSize="{StaticResource TextSizeSubhead}" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="数据" Style="{StaticResource SecondaryButton}"
                            Padding="18,7" Click="OnOpenData"/>
                    <Button Content="回放" Style="{StaticResource SecondaryButton}"
                            Padding="18,7" Margin="8,0,0,0" Click="OnOpenSearch"/>
                    <Button Content="设置" Style="{StaticResource SecondaryButton}"
                            Padding="18,7" Margin="8,0,0,0" Click="OnOpenSettings"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- ══ 常驻状态栏（T13）══════════════════════════════════════════
         ⚠️ 五项一律走**已有的**数据源，一项都不另算 ——
            录制状态 = `RecordingCoordinator`（与右栏同一处）、
            机位 = `Live.Active()`（内存里的表）、
            磁盘 = `Storage.ActiveRoot` 上那个已经在用的 `FormatFreeSpace`、
            许可 = `StatusSummaries.License`（**完整那句话，不是另写一句短的**；
                   两句话迟早会打架，而「侧栏说已激活、状态栏说未激活」
                   比哪一边说错都更让人不敢信这个界面）、
            端口 = `Services.PlaybackPort`。
         ⚠️ 没有分隔符点心：点太浅（`CardBorder` 压在 `Surface` 上几乎看不见），
            改成左边距 18 —— 状态栏本来就该是几段各自独立的文字。
         ════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="1" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
            Padding="16,7">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusRecordingText" Style="{StaticResource Caption}"
                           FontWeight="SemiBold" Text="空闲"/>
                <TextBlock x:Name="StatusSeatsText" Style="{StaticResource Caption}"
                           Margin="18,0,0,0" Text="在线机位 —"/>
                <TextBlock x:Name="StatusDiskText" Style="{StaticResource Caption}"
                           Margin="18,0,0,0" Text="本机存档盘 —"/>
                <TextBlock x:Name="StatusLicenseText" Style="{StaticResource Caption}"
                           Margin="18,0,0,0" Text="许可 —"/>
            </StackPanel>

            <TextBlock x:Name="StatusPortText" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="端口 —"/>
        </Grid>
    </Border>
    </Grid>
</Window>
